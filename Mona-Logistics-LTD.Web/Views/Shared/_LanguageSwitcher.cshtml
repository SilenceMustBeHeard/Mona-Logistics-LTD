@{
    var currentCulture = Context.Request.Cookies[".AspNetCore.Culture"];
    var isBulgarian = currentCulture?.Contains("bg-BG") ?? true;
    var isEnglish = currentCulture?.Contains("en-US") ?? false;
}

<div class="language-switcher">
    <a href="#" class="lang-link @(isBulgarian ? "active" : "")" onclick="setLanguage('bg-BG')">БГ</a>
    <span class="lang-separator">|</span>
    <a href="#" class="lang-link @(isEnglish ? "active" : "")" onclick="setLanguage('en-US')">EN</a>
</div>

<form id="cultureForm" method="post" style="display: none;">
    <input type="hidden" name="culture" id="cultureInput" />
    <input type="hidden" name="returnUrl" id="returnUrlInput" />
</form>

<script>
    function setLanguage(culture) {
        document.getElementById('cultureInput').value = culture;
        document.getElementById('returnUrlInput').value = window.location.pathname + window.location.search;

        fetch('/Home/SetLanguage', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/x-www-form-urlencoded',
                'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || ''
            },
            body: `culture=${culture}&returnUrl=${encodeURIComponent(window.location.pathname)}`
        }).then(() => {
            location.reload();
        });
    }
</script>

<style>
    .language-switcher {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        margin-right: 15px;
        padding-right: 15px;
        border-right: 1px solid rgba(255, 255, 255, 0.2);
    }

    .lang-link {
        color: rgba(255, 255, 255, 0.7);
        text-decoration: none;
        font-size: 0.8rem;
        font-weight: 500;
        transition: color 0.2s ease;
        padding: 2px 4px;
        cursor: pointer;
    }

        .lang-link:hover {
            color: var(--logistics-accent, #d4a017);
        }

        .lang-link.active {
            color: var(--logistics-accent, #d4a017);
            font-weight: 700;
        }

    .lang-separator {
        color: rgba(255, 255, 255, 0.3);
        font-size: 0.7rem;
    }
</style>