@model bool

@using Mona_Logistics_LTD.Data.Models.Base
@using Microsoft.AspNetCore.Identity
@inject SignInManager<AppUser> SignInManager
@inject UserManager<AppUser> UserManager

@{
    string displayName = null;

    if (Model)
    {
        var user = await UserManager.GetUserAsync(User);

        if (user != null)
        {
            displayName = !string.IsNullOrEmpty(user.FirstName)
                ? user.FirstName
                : user.UserName?.Split('@')[0] ?? user.Email;
        }
    }
}

@if (Model)
{
    <li class="dropdown-header border-bottom mb-2 pb-2">
        <div class="d-flex align-items-center gap-2">
            <i class="bi bi-truck text-accent"></i>
            <div>
                <small class="text-muted d-block">Welcome back,</small>
                <strong class="text-glow">@displayName</strong>
            </div>
        </div>
    </li>

    @if (!User.IsInRole("Admin") && !User.IsInRole("Manager"))
    {
        <li>
            <a class="dropdown-item" asp-controller="Profile" asp-action="Index">
                <i class="bi bi-person-badge me-2 text-accent"></i> My Profile
            </a>
        </li>
        <li>
            <a class="dropdown-item" asp-controller="Shipment" asp-action="MyShipments">
                <i class="bi bi-box-seam me-2 text-accent"></i> My Shipments
            </a>
        </li>
        <li>
            <a class="dropdown-item d-flex justify-content-between align-items-center"
               asp-controller="Messages" asp-action="Inbox">
                <span>
                    <i class="bi bi-envelope-paper me-2 text-accent"></i> Messages
                </span>
                @await Component.InvokeAsync("UnreadMessageBadge")
            </a>
        </li>
    }

    @if (User.IsInRole("Admin"))
    {
        <li><hr class="dropdown-divider"></li>
        <li>
            <a class="dropdown-item" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
                <i class="bi bi-shield-lock me-2 text-accent"></i> Admin Dashboard
            </a>
        </li>
        <li>
            <a class="dropdown-item" asp-area="Admin" asp-controller="UserManagement" asp-action="Index">
                <i class="bi bi-people me-2 text-accent"></i> User Management
            </a>
        </li>
        <li>
            <a class="dropdown-item" asp-area="Admin" asp-controller="SystemMessage" asp-action="Index">
                <i class="bi bi-megaphone me-2 text-accent"></i> System Messages
            </a>
        </li>
    }

    @if (User.IsInRole("Manager"))
    {
        <li><hr class="dropdown-divider"></li>
        <li>
            <a class="dropdown-item" asp-area="Manager" asp-controller="Dashboard" asp-action="Index">
                <i class="bi bi-clipboard-data me-2 text-accent"></i> Manager Dashboard
            </a>
        </li>
        <li>
            <a class="dropdown-item" asp-area="Manager" asp-controller="ShipmentManagement" asp-action="Index">
                <i class="bi bi-box-seam me-2 text-accent"></i> Manage Shipments
            </a>
        </li>
    }

    <li><hr class="dropdown-divider"></li>

    <li class="px-3 py-2">
        <form asp-controller="Account" asp-action="Logout" method="post">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn-logistics w-100">
                <i class="bi bi-box-arrow-right me-2"></i> Logout
            </button>
        </form>
    </li>
}
else
{
    <li class="dropdown-header border-bottom mb-2 pb-2">
        <div class="d-flex align-items-center gap-2">
            <i class="bi bi-truck text-accent"></i>
            <small class="text-muted">Welcome to MONA Logistics</small>
        </div>
    </li>

    <li>
        <a class="dropdown-item" asp-controller="Account" asp-action="Login">
            <i class="bi bi-box-arrow-in-right me-2 text-accent"></i> Login
        </a>
    </li>

    <li>
        <a class="dropdown-item" asp-controller="Account" asp-action="Register">
            <i class="bi bi-person-plus me-2 text-accent"></i> Register
        </a>
    </li>
}