@model Mona_Logistics_LTD.Web.ViewModels.NavbarButtonsViewModel

<div class="nav-links d-flex gap-3">
    <a class="nav-link-logistics" asp-controller="Home" asp-action="Index">
        <i class="bi bi-house-door me-1"></i> @Localizer["Home"]
    </a>

    @if (Model.IsLoggedIn)
    {
        @if (Model.IsAdmin)
        {
            <a class="nav-link-logistics" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
                <i class="bi bi-speedometer2 me-1"></i> @Localizer["Dashboard"]
            </a>
            <a class="nav-link-logistics" asp-area="Admin" asp-controller="ShipmentManagement" asp-action="Index">
                <i class="bi bi-box-seam me-1"></i> @Localizer["Shipments"]
            </a>
            <a class="nav-link-logistics" asp-area="Admin" asp-controller="TruckManagement" asp-action="Index">
                <i class="bi bi-truck me-1"></i> @Localizer["CarrierNetwork"]
            </a>
            <a class="nav-link-logistics" asp-area="Admin" asp-controller="SystemMessage" asp-action="Index">
                <i class="bi bi-megaphone me-1"></i> @Localizer["Broadcast"]
            </a>
        }
        else if (Model.IsManager)
        {
            <a class="nav-link-logistics" asp-area="Manager" asp-controller="Dashboard" asp-action="Index">
                <i class="bi bi-clipboard-data me-1"></i> @Localizer["Dashboard"]
            </a>
            <a class="nav-link-logistics" asp-area="Manager" asp-controller="ShipmentManagement" asp-action="Index">
                <i class="bi bi-box-seam me-1"></i> @Localizer["Shipments"]
            </a>
            <a class="nav-link-logistics" asp-area="Manager" asp-controller="DriverManagement" asp-action="Index">
                <i class="bi bi-person-badge me-1"></i> @Localizer["TransportPartners"]
            </a>
        }
        else
        {
            <a class="nav-link-logistics" asp-controller="Shipment" asp-action="MyShipments">
                <i class="bi bi-box-seam me-1"></i> @Localizer["MyShipments"]
            </a>
            <a class="nav-link-logistics position-relative" asp-controller="Messages" asp-action="Inbox">
                <i class="bi bi-envelope-paper me-1"></i> @Localizer["Messages"]
                @if (Model.UnreadMessagesCount > 0)
                {
                    <span class="unread-badge-logistics">@Model.UnreadMessagesCount</span>
                }
            </a>
        }

        <a class="nav-link-logistics" asp-controller="Track" asp-action="Index">
            <i class="bi bi-geo-alt me-1"></i> @Localizer["TrackShipment"]
        </a>
    }
    else
    {
        <a class="nav-link-logistics" asp-controller="Home" asp-action="About">
            <i class="bi bi-info-circle me-1"></i> @Localizer["About"]
        </a>
        <a class="nav-link-logistics" asp-controller="Services" asp-action="Index">
            <i class="bi bi-truck me-1"></i> @Localizer["Services"]
        </a>
        <a class="nav-link-logistics" asp-controller="Contact" asp-action="Index">
            <i class="bi bi-envelope me-1"></i> @Localizer["Contact"]
        </a>
    }
</div>