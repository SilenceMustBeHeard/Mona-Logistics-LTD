@using Mona_Logistics_LTD.Data.Common.Enums
@using Mona_Logistics_LTD.Data.Models.Loads
@model IEnumerable<Offer>

@{
    ViewData["Title"] = Localizer["OffersTitle"];
    var requestId = ViewBag.RequestId as Guid?;
    var cargoName = ViewBag.RequestCargoName as string;
    var canAcceptOffer = ViewBag.CanAcceptOffer as bool? ?? false;
}

<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap">
        <div>
            <h1 style="color: white;">@Localizer["OffersTitle"]</h1>
            <p style="color: rgba(255,255,255,0.6);">
                @Localizer["OffersSubtitle"] <strong style="color: var(--logistics-accent);">@cargoName</strong>
            </p>
        </div>
        <a asp-controller="LoadRequest" asp-action="Details" asp-route-id="@requestId" class="btn-logistics-outline" style="padding: 8px 20px;">
            <i class="bi bi-arrow-left me-1"></i> @Localizer["BackToRequest"]
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="text-center py-5 logistics-card">
            <i class="bi bi-file-earmark-text display-4" style="color: rgba(255,255,255,0.2);"></i>
            <p class="mt-3" style="color: rgba(255,255,255,0.6);">@Localizer["NoOffersYet"]</p>
            <p style="color: rgba(255,255,255,0.3);">@Localizer["OffersWaiting"]</p>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var offer in Model)
            {
                var isExpired = offer.Status == OfferStatus.Pending && offer.ValidUntil <= DateTime.UtcNow;
                var canAccept = offer.Status == OfferStatus.Pending && offer.ValidUntil > DateTime.UtcNow && canAcceptOffer;
                var isAccepted = offer.Status == OfferStatus.Accepted;
                var isRejected = offer.Status == OfferStatus.Rejected;

                <div class="col-md-6">
                    <div class="offer-card @(isAccepted ? "offer-accepted" : "") @(isRejected ? "offer-rejected" : "") @(isExpired ? "offer-expired" : "")">
                        @if (isAccepted)
                        {
                            <div class="offer-badge accepted">✅ @Localizer["Accepted"]</div>
                        }
                        else if (isRejected)
                        {
                            <div class="offer-badge rejected">❌ @Localizer["Rejected"]</div>
                        }
                        else if (isExpired)
                        {
                            <div class="offer-badge expired">⏰ @Localizer["Expired"]</div>
                        }
                        else if (canAccept)
                        {
                            <div class="offer-badge pending">⏳ @Localizer["Pending"]</div>
                        }

                        <div class="offer-price">@offer.FinalPrice.ToString("F2") BGN</div>

                        @if (offer.Discount.HasValue && offer.Discount > 0)
                        {
                            <div class="offer-discount">
                                <span class="original-price">@offer.Price.ToString("F2") BGN</span>
                                <span class="discount-badge">-@offer.Discount.Value.ToString("F2") BGN</span>
                            </div>
                        }

                        <div class="offer-details">
                            <div class="offer-detail">
                                <span class="detail-label">@Localizer["ValidUntil"]</span>
                                <span class="detail-value">@offer.ValidUntil.ToLocalTime().ToString("dd MMM yyyy HH:mm")</span>
                            </div>
                            <div class="offer-detail">
                                <span class="detail-label">@Localizer["CreatedBy"]</span>
                                <span class="detail-value">@offer.CreatedBy</span>
                            </div>
                            @if (!string.IsNullOrEmpty(offer.Notes))
                            {
                                <div class="offer-detail">
                                    <span class="detail-label">@Localizer["Notes"]</span>
                                    <span class="detail-value">@offer.Notes</span>
                                </div>
                            }
                        </div>

                        @if (canAccept)
                        {
                            <div class="offer-actions">
                                <form asp-action="Accept" method="post" style="display:inline;">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@offer.Id" />
                                    <input type="hidden" name="requestId" value="@requestId" />
                                    <button type="submit" class="btn-logistics-primary flex-fill" onclick="return confirm('@Localizer["AcceptOfferConfirm"]')">
                                        <i class="bi bi-check-circle me-2"></i> @Localizer["AcceptOffer"]
                                    </button>
                                </form>
                                <form asp-action="Reject" method="post" style="display:inline;">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@offer.Id" />
                                    <input type="hidden" name="requestId" value="@requestId" />
                                    <button type="submit" class="btn-logistics-outline flex-fill" onclick="return confirm('@Localizer["RejectOfferConfirm"]')">
                                        <i class="bi bi-x-circle me-2"></i> @Localizer["RejectOffer"]
                                    </button>
                                </form>
                            </div>
                        }
                        else if (isAccepted)
                        {
                            <div class="offer-status-message accepted-message">
                                <i class="bi bi-check-circle-fill me-2"></i> @Localizer["OfferAcceptedMessage"]
                            </div>
                        }
                        else if (isRejected)
                        {
                            <div class="offer-status-message rejected-message">
                                <i class="bi bi-x-circle-fill me-2"></i> @Localizer["OfferRejectedMessage"]
                            </div>
                        }
                        else if (isExpired)
                        {
                            <div class="offer-status-message expired-message">
                                <i class="bi bi-clock-fill me-2"></i> @Localizer["OfferExpiredMessage"]
                            </div>
                        }
                        else
                        {
                            <div class="offer-status-message waiting-message">
                                <i class="bi bi-hourglass-split me-2"></i> @Localizer["OfferWaitingMessage"]
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    }
</div>

@section Styles {
    <style>
        .offer-card {
            background: var(--logistics-primary-dark);
            border: 1px solid rgba(212, 160, 23, 0.15);
            border-radius: 16px;
            padding: 24px;
            position: relative;
            transition: all 0.3s ease;
        }

            .offer-card:hover:not(.offer-accepted):not(.offer-rejected) {
                transform: translateY(-4px);
                border-color: var(--logistics-accent);
            }

        .offer-accepted {
            border-color: #28a745;
        }

        .offer-rejected {
            border-color: #dc3545;
            opacity: 0.7;
        }

        .offer-expired {
            border-color: #6c757d;
            opacity: 0.5;
        }

        .offer-badge {
            display: inline-block;
            padding: 4px 12px;
            border-radius: 30px;
            font-size: 0.8rem;
            font-weight: 600;
            margin-bottom: 12px;
        }

            .offer-badge.accepted {
                background: rgba(40, 167, 69, 0.15);
                color: #28a745;
            }

            .offer-badge.rejected {
                background: rgba(220, 53, 69, 0.15);
                color: #dc3545;
            }

            .offer-badge.expired {
                background: rgba(108, 117, 125, 0.15);
                color: #6c757d;
            }

            .offer-badge.pending {
                background: rgba(212, 160, 23, 0.15);
                color: var(--logistics-accent);
            }

        .offer-price {
            font-size: 2rem;
            font-weight: 700;
            color: var(--logistics-accent);
            margin-bottom: 4px;
        }

        .offer-discount {
            font-size: 0.9rem;
            margin-bottom: 16px;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .original-price {
            text-decoration: line-through;
            color: rgba(255,255,255,0.3);
        }

        .discount-badge {
            background: rgba(40, 167, 69, 0.15);
            color: #28a745;
            padding: 2px 10px;
            border-radius: 20px;
            font-weight: 600;
        }

        .offer-details {
            margin-bottom: 16px;
        }

        .offer-detail {
            display: flex;
            justify-content: space-between;
            padding: 4px 0;
            border-bottom: 1px solid rgba(255,255,255,0.03);
        }

            .offer-detail .detail-label {
                color: rgba(255,255,255,0.4);
                font-size: 0.85rem;
            }

            .offer-detail .detail-value {
                color: rgba(255,255,255,0.8);
                font-size: 0.85rem;
            }

        .offer-actions {
            display: flex;
            gap: 10px;
            margin-top: 12px;
        }

        .offer-status-message {
            padding: 12px;
            border-radius: 10px;
            text-align: center;
            font-weight: 500;
            margin-top: 8px;
        }

        .accepted-message {
            background: rgba(40, 167, 69, 0.1);
            color: #28a745;
        }

        .rejected-message {
            background: rgba(220, 53, 69, 0.1);
            color: #dc3545;
        }

        .expired-message {
            background: rgba(108, 117, 125, 0.1);
            color: #6c757d;
        }

        .waiting-message {
            background: rgba(212, 160, 23, 0.05);
            color: rgba(255,255,255,0.4);
        }
    </style>
}