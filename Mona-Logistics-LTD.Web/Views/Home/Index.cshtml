@using Cms.AspNetCore.JsonLocalizer.Interfaces
@inject ILocalizer Localizer



@{
    ViewData["Title"] = Localizer.GetString("HomeTitle")?.Value ?? "Mona Logistics - Доставяме решения, движим бизнеса напред";
}

<link rel="stylesheet" href="~/css/pages/home.css" asp-append-version="true" />

<!-- Hero Section -->
<section class="home-hero">
    <div class="container">
        <div class="home-hero-content">
            <div class="home-hero-badge">
                <span class="home-hero-icon">🚛</span>
                <span class="home-hero-tag">@Localizer.GetString("OfficialPartner")?.Value</span>
            </div>
            <h1 class="home-hero-title">
                @Localizer.GetString("HeroTitle")?.Value<br>
                <span class="home-hero-title-accent">@Localizer.GetString("HeroTitleAccent")?.Value</span>
            </h1>
            <p class="home-hero-description">
                @Localizer.GetString("HeroDescription")?.Value
            </p>
            <div class="home-hero-buttons">
                <a href="/Identity/Account/Register" class="home-hero-btn-primary">
                    <i class="bi bi-person-plus-fill"></i> @Localizer.GetString("Register")?.Value
                </a>
                <a href="/Shipment/Track" class="home-hero-btn-secondary">
                    <i class="bi bi-search"></i> @Localizer.GetString("TrackShipment")?.Value
                </a>
            </div>
        </div>
    </div>

    <!-- Decorative elements -->
    <div class="home-hero-glow-1"></div>
    <div class="home-hero-glow-2"></div>
</section>

<!-- Stats Section -->
<section class="home-stats">
    <div class="container">
        <div class="home-stats-grid">
            <div class="home-stat-card">
                <div class="home-stat-number">5000+</div>
                <div class="home-stat-label">@Localizer.GetString("StatDeliveries")?.Value</div>
            </div>
            <div class="home-stat-card">
                <div class="home-stat-number">98%</div>
                <div class="home-stat-label">@Localizer.GetString("StatOnTime")?.Value</div>
            </div>
            <div class="home-stat-card">
                <div class="home-stat-number">50+</div>
                <div class="home-stat-label">@Localizer.GetString("StatTrucks")?.Value</div>
            </div>
            <div class="home-stat-card">
                <div class="home-stat-number">24/7</div>
                <div class="home-stat-label">@Localizer.GetString("StatSupport")?.Value</div>
            </div>
        </div>
    </div>
</section>

<!-- Services Section -->
<section class="home-services">
    <div class="container">
        <div class="home-section-header">
            <span class="home-section-tag">@Localizer.GetString("ServicesTag")?.Value</span>
            <h2 class="home-section-title">@Localizer.GetString("ServicesTitle")?.Value</h2>
            <p class="home-section-subtitle">@Localizer.GetString("ServicesSubtitle")?.Value</p>
        </div>

        <div class="home-services-grid">
            <div class="home-service-card">
                <div class="home-service-icon">🚚</div>
                <h3 class="home-service-title">@Localizer.GetString("ServiceTransportTitle")?.Value</h3>
                <p class="home-service-description">@Localizer.GetString("ServiceTransportDesc")?.Value</p>
                <a href="/Services/Transport" class="home-service-link">@Localizer.GetString("LearnMore")?.Value →</a>
            </div>

            <div class="home-service-card">
                <div class="home-service-icon">📦</div>
                <h3 class="home-service-title">@Localizer.GetString("ServiceWarehouseTitle")?.Value</h3>
                <p class="home-service-description">@Localizer.GetString("ServiceWarehouseDesc")?.Value</p>
                <a href="/Services/Warehouse" class="home-service-link">@Localizer.GetString("LearnMore")?.Value →</a>
            </div>

            <div class="home-service-card">
                <div class="home-service-icon">🛰️</div>
                <h3 class="home-service-title">@Localizer.GetString("ServiceTrackingTitle")?.Value</h3>
                <p class="home-service-description">@Localizer.GetString("ServiceTrackingDesc")?.Value</p>
                <a href="/Services/Tracking" class="home-service-link">@Localizer.GetString("LearnMore")?.Value →</a>
            </div>

            <div class="home-service-card">
                <div class="home-service-icon">🌍</div>
                <h3 class="home-service-title">@Localizer.GetString("ServiceInternationalTitle")?.Value</h3>
                <p class="home-service-description">@Localizer.GetString("ServiceInternationalDesc")?.Value</p>
                <a href="/Services/International" class="home-service-link">@Localizer.GetString("LearnMore")?.Value →</a>
            </div>
        </div>
    </div>
</section>

<!-- Why Choose Us Section -->
<section class="home-whyus">
    <div class="container">
        <div class="home-whyus-grid">
            <div class="home-whyus-content">
                <span class="home-whyus-tag">@Localizer.GetString("WhyUsTag")?.Value</span>
                <h2 class="home-whyus-title">@Localizer.GetString("WhyUsTitle")?.Value</h2>
                <p class="home-whyus-description">@Localizer.GetString("WhyUsDescription")?.Value</p>

                <div class="home-whyus-item">
                    <i class="bi bi-check-circle-fill home-whyus-icon"></i>
                    <div>
                        <h4>@Localizer.GetString("WhyUsTeam")?.Value</h4>
                        <p class="home-whyus-item-text">@Localizer.GetString("WhyUsTeamDesc")?.Value</p>
                    </div>
                </div>

                <div class="home-whyus-item">
                    <i class="bi bi-shield-check home-whyus-icon"></i>
                    <div>
                        <h4>@Localizer.GetString("WhyUsInsurance")?.Value</h4>
                        <p class="home-whyus-item-text">@Localizer.GetString("WhyUsInsuranceDesc")?.Value</p>
                    </div>
                </div>

                <div class="home-whyus-item">
                    <i class="bi bi-clock-history home-whyus-icon"></i>
                    <div>
                        <h4>@Localizer.GetString("WhyUsSupport")?.Value</h4>
                        <p class="home-whyus-item-text">@Localizer.GetString("WhyUsSupportDesc")?.Value</p>
                    </div>
                </div>
            </div>

            <div class="home-testimonial">
                <div class="home-testimonial-card">
                    <i class="bi bi-quote home-testimonial-quote"></i>
                    <p class="home-testimonial-text">@Localizer.GetString("TestimonialText")?.Value</p>
                    <div class="home-testimonial-author">@Localizer.GetString("TestimonialAuthor")?.Value</div>
                    <div class="home-testimonial-title">@Localizer.GetString("TestimonialTitle")?.Value</div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Partners Section -->
<section class="home-partners">
    <div class="container">
        <div class="home-partners-header">
            <h2 class="home-partners-title">@Localizer.GetString("PartnersTitle")?.Value</h2>
            <p class="home-partners-subtitle">@Localizer.GetString("PartnersSubtitle")?.Value</p>
        </div>

        <div class="home-partners-grid">
            <span class="home-partner-logo">FANTASTICO</span>
            <span class="home-partner-logo">METRO</span>
            <span class="home-partner-logo">LIDL</span>
            <span class="home-partner-logo">BILLA</span>
            <span class="home-partner-logo">KAUFLAND</span>
        </div>
    </div>
</section>

<!-- CTA Section -->
<section class="home-cta">
    <div class="container">
        <h2 class="home-cta-title">@Localizer.GetString("CTATitle")?.Value</h2>
        <p class="home-cta-description">@Localizer.GetString("CTADescription")?.Value</p>
        <div class="home-cta-buttons">
            <a href="/Identity/Account/Register" class="home-cta-btn-primary">
                <i class="bi bi-person-plus-fill"></i> @Localizer.GetString("Register")?.Value
            </a>
            <a href="/Contact" class="home-cta-btn-secondary">
                <i class="bi bi-envelope-fill"></i> @Localizer.GetString("ContactUs")?.Value
            </a>
        </div>
    </div>
</section>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        document.body.classList.add('page-transition');
    });
</script>