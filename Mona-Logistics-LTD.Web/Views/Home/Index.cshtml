@{
    ViewData["Title"] = Localizer["HomeTitle"];
}

<link rel="stylesheet" href="~/css/pages/home.css" asp-append-version="true" />

<!-- Hero Section -->
<section class="home-hero">
    <div class="container">
        <div class="home-hero-content">
            <div class="home-hero-badge">
                <span class="home-hero-icon">🚛</span>
                <span class="home-hero-tag">@Localizer["OfficialPartner"]</span>
            </div>
            <h1 class="home-hero-title">
                @Localizer["HeroTitle"]<br>
                <span class="home-hero-title-accent">@Localizer["HeroTitleAccent"]</span>
            </h1>
            <p class="home-hero-description">
                @Localizer["HeroDescription"]
            </p>
            <div class="home-hero-buttons">
                <a asp-controller="Account" asp-action="Register" class="home-hero-btn-primary">
                    <i class="bi bi-person-plus-fill"></i> @Localizer["Register"]
                </a>
                <a asp-controller="Shipment" asp-action="Track" class="home-hero-btn-secondary">
                    <i class="bi bi-search"></i> @Localizer["TrackShipment"]
                </a>
            </div>
        </div>
    </div>

    <div class="home-hero-glow-1"></div>
    <div class="home-hero-glow-2"></div>
</section>

<!-- Services Section -->
<section class="home-services">
    <div class="container">
        <div class="home-section-header">
            <span class="home-section-tag">@Localizer["ServicesTag"]</span>
            <h2 class="home-section-title">@Localizer["ServicesTitle"]</h2>
            <p class="home-section-subtitle">@Localizer["ServicesSubtitle"]</p>
        </div>

        <div class="home-services-grid">
            <div class="home-service-card">
                <div class="home-service-icon">🚚</div>
                <h3 class="home-service-title">@Localizer["ServiceTransportTitle"]</h3>
                <p class="home-service-description">@Localizer["ServiceTransportDesc"]</p>
                <a href="/Services/Transport" class="home-service-link">@Localizer["LearnMore"] →</a>
            </div>

            <div class="home-service-card">
                <div class="home-service-icon">📦</div>
                <h3 class="home-service-title">@Localizer["ServiceWarehouseTitle"]</h3>
                <p class="home-service-description">@Localizer["ServiceWarehouseDesc"]</p>
                <a href="/Services/Warehouse" class="home-service-link">@Localizer["LearnMore"] →</a>
            </div>

            <div class="home-service-card">
                <div class="home-service-icon">🛰️</div>
                <h3 class="home-service-title">@Localizer["ServiceTrackingTitle"]</h3>
                <p class="home-service-description">@Localizer["ServiceTrackingDesc"]</p>
                <a href="/Services/Tracking" class="home-service-link">@Localizer["LearnMore"] →</a>
            </div>

            <div class="home-service-card">
                <div class="home-service-icon">🌍</div>
                <h3 class="home-service-title">@Localizer["ServiceInternationalTitle"]</h3>
                <p class="home-service-description">@Localizer["ServiceInternationalDesc"]</p>
                <a href="/Services/International" class="home-service-link">@Localizer["LearnMore"] →</a>
            </div>
        </div>
    </div>
</section>

<!-- Why Choose Us Section -->
<section class="home-whyus">
    <div class="container">
        <div class="home-whyus-grid">
            <div class="home-whyus-content">
                <span class="home-whyus-tag">@Localizer["WhyUsTag"]</span>
                <h2 class="home-whyus-title">@Localizer["WhyUsTitle"]</h2>
                <p class="home-whyus-description">@Localizer["WhyUsDescription"]</p>

                <div class="home-whyus-item">
                    <i class="bi bi-check-circle-fill home-whyus-icon"></i>
                    <div>
                        <h4>@Localizer["WhyUsTeam"]</h4>
                        <p class="home-whyus-item-text">@Localizer["WhyUsTeamDesc"]</p>
                    </div>
                </div>

            

                <div class="home-whyus-item">
                    <i class="bi bi-clock-history home-whyus-icon"></i>
                    <div>
                        <h4>@Localizer["WhyUsSupport"]</h4>
                        <p class="home-whyus-item-text">@Localizer["WhyUsSupportDesc"]</p>
                    </div>
                </div>
            </div>

            <div class="home-testimonial">
                <div class="home-testimonial-card">
                    <i class="bi bi-quote home-testimonial-quote"></i>
                    <p class="home-testimonial-text">@Localizer["TestimonialText"]</p>
                    <div class="home-testimonial-author">@Localizer["TestimonialAuthor"]</div>
                    <div class="home-testimonial-title">@Localizer["TestimonialTitle"]</div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Partners Section -->
<section class="home-partners">
    <div class="container">
        <div class="home-partners-header">
            <h2 class="home-partners-title">@Localizer["PartnersTitle"]</h2>
            <p class="home-partners-subtitle">@Localizer["PartnersSubtitle"]</p>
        </div>

        <div class="home-partners-grid">
            <span class="home-partner-logo">FANTASTICO</span>
            <span class="home-partner-logo">METRO</span>
            <span class="home-partner-logo">LIDL</span>
            <span class="home-partner-logo">BILLA</span>
            <span class="home-partner-logo">KAUFLAND</span>
        </div>
    </div>
</section>

<!-- CTA Section -->
<section class="home-cta">
    <div class="container">
        <h2 class="home-cta-title">@Localizer["CTATitle"]</h2>
        <p class="home-cta-description">@Localizer["CTADescription"]</p>
        <div class="home-cta-buttons">
            <a asp-controller="Account" asp-action="Register" class="home-cta-btn-primary">
                <i class="bi bi-person-plus-fill"></i> @Localizer["Register"]
            </a>
        @*     <a href="/Contact" class="home-cta-btn-secondary">
                <i class="bi bi-envelope-fill"></i> @Localizer["ContactUs"]
            </a> *@
        </div>
    </div>
</section>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        document.body.classList.add('page-transition');
    });
</script>