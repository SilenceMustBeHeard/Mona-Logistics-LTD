@using Mona_Logistics_LTD.Data.Common.Enums
@using Mona_Logistics_LTD.Data.Models.Loads
@model IEnumerable<TruckAvailability>

@{
    ViewData["Title"] = Localizer["MyTruckListingsTitle"];
}

<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap">
        <div>
            <h1 style="color: white;">@Localizer["MyTruckListingsTitle"]</h1>
            <p style="color: rgba(255,255,255,0.6);">@Localizer["MyTruckListingsSubtitle"]</p>
        </div>
        <a asp-action="Create" class="btn-logistics-primary">
            <i class="bi bi-plus-lg me-2"></i> @Localizer["NewTruckListing"]
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="text-center py-5 logistics-card">
            <i class="bi bi-truck display-4" style="color: rgba(255,255,255,0.2);"></i>
            <p class="mt-3" style="color: rgba(255,255,255,0.6);">@Localizer["NoTruckListings"]</p>
            <a asp-action="Create" class="btn-logistics-primary mt-3">
                <i class="bi bi-plus-lg me-2"></i> @Localizer["CreateFirstListing"]
            </a>
        </div>
    }
    else
    {
        <div class="table-container">
            <table class="table">
                <thead>
                    <tr>
                        <th>@Localizer["CurrentLocation"]</th>
                        <th>@Localizer["Destination"]</th>
                        <th>@Localizer["AvailableWeightKg"]</th>
                        <th>@Localizer["AvailableLinearMeters"]</th>
                        <th>@Localizer["AvailableFrom"]</th>
                        <th>@Localizer["Status"]</th>
                        <th>@Localizer["Actions"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var listing in Model)
                    {
                        <tr>
                            <td>@listing.CurrentLocation</td>
                            <td>@(listing.Destination ?? Localizer["NotSpecified"])</td>
                            <td>@listing.AvailableWeightKg kg</td>
                            <td>@listing.AvailableLinearMeters.ToString("F2") lm</td>
                            <td>@listing.AvailableFrom.ToString("dd MMM yyyy")</td>
                            <td>
                                <span class="status-badge @(listing.Status switch
                                      {
                                          TruckAvailabilityStatus.Available => "status-available",
                                          TruckAvailabilityStatus.Reserved => "status-reserved",
                                          TruckAvailabilityStatus.Matched => "status-matched",
                                          TruckAvailabilityStatus.Expired => "status-expired",
                                          TruckAvailabilityStatus.Cancelled => "status-cancelled",
                                          _ => ""
                                      })">
                                    @(listing.Status switch
                                    {
                                        TruckAvailabilityStatus.Available => Localizer["Available"],
                                        TruckAvailabilityStatus.Reserved => Localizer["Reserved"],
                                        TruckAvailabilityStatus.Matched => Localizer["Matched"],
                                        TruckAvailabilityStatus.Expired => Localizer["Expired"],
                                        TruckAvailabilityStatus.Cancelled => Localizer["Cancelled"],
                                        _ => listing.Status.ToString()
                                    })
                                </span>
                            </td>
                            <td>
                                <div class="d-flex gap-2 flex-wrap">
                                    <a asp-action="Details" asp-route-id="@listing.Id" class="btn-sm btn-logistics-outline">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    @if (listing.Status == TruckAvailabilityStatus.Available || listing.Status == TruckAvailabilityStatus.Reserved)
                                    {
                                        <a asp-action="Edit" asp-route-id="@listing.Id" class="btn-sm btn-logistics-outline">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <form asp-action="Cancel" asp-route-id="@listing.Id" method="post" style="display:inline;">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn-sm btn-logistics-outline" style="border-color: #e63946; color: #e63946;" onclick="return confirm('@Localizer["CancelListingConfirm"]')">
                                                <i class="bi bi-x-lg"></i>
                                            </button>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>