@using Mona_Logistics_LTD.Data.Models.Loads
@model IEnumerable<TruckAvailability>

@{
    ViewData["Title"] = Localizer["BrowseTruckListingsTitle"];
}

<div class="container py-5">
    <div class="text-center mb-5">
        <h1 style="color: white;">@Localizer["BrowseTruckListingsTitle"]</h1>
        <p style="color: rgba(255,255,255,0.6);">@Localizer["BrowseTruckListingsSubtitle"]</p>
        <div class="accent-line mx-auto"></div>
    </div>

    @if (!Model.Any())
    {
        <div class="text-center py-5 logistics-card">
            <i class="bi bi-truck display-4" style="color: rgba(255,255,255,0.2);"></i>
            <p class="mt-3" style="color: rgba(255,255,255,0.6);">@Localizer["NoAvailableTrucks"]</p>
            <p style="color: rgba(255,255,255,0.3);">@Localizer["CheckBackLater"]</p>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var listing in Model)
            {
                <div class="col-md-6">
                    <div class="logistics-card p-4 listing-card">
                        <div class="d-flex justify-content-between align-items-start mb-3">
                            <h3 style="color: white; font-size: 1.2rem;">@listing.CurrentLocation</h3>
                            <span class="status-badge status-available">@Localizer["Available"]</span>
                        </div>

                        <div class="row g-2">
                            <div class="col-6">
                                <span style="color: rgba(255,255,255,0.4); font-size: 0.85rem;">@Localizer["Destination"]</span>
                                <p style="color: rgba(255,255,255,0.8);">@(listing.Destination ?? Localizer["NotSpecified"])</p>
                            </div>
                            <div class="col-6">
                                <span style="color: rgba(255,255,255,0.4); font-size: 0.85rem;">@Localizer["AvailableFrom"]</span>
                                <p style="color: rgba(255,255,255,0.8);">@listing.AvailableFrom.ToString("dd MMM yyyy")</p>
                            </div>
                            <div class="col-6">
                                <span style="color: rgba(255,255,255,0.4); font-size: 0.85rem;">@Localizer["Weight"]</span>
                                <p style="color: rgba(255,255,255,0.8);">@listing.AvailableWeightKg kg</p>
                            </div>
                            <div class="col-6">
                                <span style="color: rgba(255,255,255,0.4); font-size: 0.85rem;">@Localizer["LinearMeters"]</span>
                                <p style="color: rgba(255,255,255,0.8);">@listing.AvailableLinearMeters.ToString("F2") lm</p>
                            </div>
                        </div>

                        <div class="mt-3 d-flex gap-2 flex-wrap">
                            @if (listing.HasCooling)
                            {
                                <span class="feature-badge"><i class="bi bi-snow2 me-1"></i> @Localizer["Cooling"]</span>
                            }
                            @if (listing.HasTailLift)
                            {
                                <span class="feature-badge"><i class="bi bi-arrow-up me-1"></i> @Localizer["TailLift"]</span>
                            }
                            <span class="feature-badge">@listing.VehicleType</span>
                        </div>

                        @if (!string.IsNullOrEmpty(listing.Notes))
                        {
                            <p style="color: rgba(255,255,255,0.4); font-size: 0.85rem; margin-top: 8px;">@listing.Notes</p>
                        }

                        <div class="mt-3">
                            <a asp-action="Details" asp-route-id="@listing.Id" class="btn-logistics-primary" style="padding: 8px 20px;">
                                @Localizer["ViewDetails"]
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

<style>
    .listing-card {
        transition: all 0.3s ease;
    }

        .listing-card:hover {
            transform: translateY(-4px);
            border-color: var(--logistics-accent);
        }

    .feature-badge {
        display: inline-block;
        padding: 2px 10px;
        border-radius: 20px;
        font-size: 0.75rem;
        background: rgba(212, 160, 23, 0.1);
        color: var(--logistics-accent);
        border: 1px solid rgba(212, 160, 23, 0.15);
    }

    .status-available {
        background: rgba(40, 167, 69, 0.15);
        color: #28a745;
    }
</style>