@using Mona_Logistics_LTD.Web.ViewModels.Client.TruckAvailability
@model TruckAvailabilityCreateViewModel

@{
    ViewData["Title"] = Localizer["ReviewTruckListingTitle"];
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="logistics-card p-4 p-md-5">
                <div class="text-center mb-4">
                    <i class="bi bi-check-circle display-4" style="color: var(--logistics-accent);"></i>
                    <h1 class="h2 mt-3" style="color: white;">@Localizer["ReviewTruckListingTitle"]</h1>
                    <p style="color: rgba(255,255,255,0.6);">@Localizer["ReviewTruckListingSubtitle"]</p>
                    <div class="accent-line mx-auto"></div>
                </div>

                <div class="review-section">
                    <!-- Truck Details -->
                    <div class="review-group mb-4">
                        <h6 class="text-accent mb-3">@Localizer["TruckDetailsTitle"]</h6>
                        <div class="review-item">
                            <span class="review-label">@Localizer["AvailableWeightKg"]</span>
                            <span class="review-value">@Model.AvailableWeightKg kg</span>
                        </div>
                        <div class="review-item">
                            <span class="review-label">@Localizer["AvailableLinearMeters"]</span>
                            <span class="review-value">@Model.AvailableLinearMeters.ToString("F2") lm</span>
                        </div>
                        <div class="review-item">
                            <span class="review-label">@Localizer["AvailableVolumeM3"]</span>
                            <span class="review-value">@Model.AvailableVolumeM3 m³</span>
                        </div>
                    </div>

                    <!-- Route Details -->
                    <div class="review-group mb-4">
                        <h6 class="text-accent mb-3">@Localizer["RouteDetailsTitle"]</h6>
                        <div class="review-item">
                            <span class="review-label">@Localizer["CurrentLocation"]</span>
                            <span class="review-value">@Model.CurrentLocation</span>
                        </div>
                        <div class="review-item">
                            <span class="review-label">@Localizer["Destination"]</span>
                            <span class="review-value">@(string.IsNullOrEmpty(Model.Destination) ? Localizer["NotSpecified"] : Model.Destination)</span>
                        </div>
                        <div class="review-item">
                            <span class="review-label">@Localizer["AvailableFrom"]</span>
                            <span class="review-value">@Model.AvailableFrom.ToString("dd MMM yyyy HH:mm")</span>
                        </div>
                        <div class="review-item">
                            <span class="review-label">@Localizer["AvailableUntil"]</span>
                            <span class="review-value">@(Model.AvailableUntil?.ToString("dd MMM yyyy HH:mm") ?? Localizer["NotSpecified"])</span>
                        </div>
                    </div>

                    <!-- Vehicle Features -->
                    <div class="review-group mb-4">
                        <h6 class="text-accent mb-3">@Localizer["VehicleFeaturesTitle"]</h6>
                        <div class="review-item">
                            <span class="review-label">@Localizer["VehicleType"]</span>
                            <span class="review-value">@Model.VehicleTypeDisplay</span>
                        </div>
                        <div class="review-item">
                            <span class="review-label">@Localizer["HasCooling"]</span>
                            <span class="review-value">@(Model.HasCooling ? "✅ Yes" : "❌ No")</span>
                        </div>
                        <div class="review-item">
                            <span class="review-label">@Localizer["HasTailLift"]</span>
                            <span class="review-value">@(Model.HasTailLift ? "✅ Yes" : "❌ No")</span>
                        </div>
                        @if (!string.IsNullOrEmpty(Model.Notes))
                        {
                            <div class="review-item">
                                <span class="review-label">@Localizer["Notes"]</span>
                                <span class="review-value">@Model.Notes</span>
                            </div>
                        }
                    </div>
                </div>

                <!-- Actions -->
                <div class="d-flex gap-3 flex-wrap mt-4">
                    <button type="submit" form="submitForm" class="btn-logistics-primary flex-fill">
                        <i class="bi bi-check-circle me-2"></i> @Localizer["SubmitListing"]
                    </button>
                    <a asp-action="Create" class="btn-logistics-outline flex-fill">
                        <i class="bi bi-pencil me-2"></i> @Localizer["EditListing"]
                    </a>
                    <a asp-controller="Home" asp-action="Index" class="btn-logistics-outline flex-fill">
                        <i class="bi bi-x-circle me-2"></i> @Localizer["Cancel"]
                    </a>
                </div>

                <form id="submitForm" asp-action="Create" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="action" value="submit" />
                    <input type="hidden" asp-for="TruckId" />
                    <input type="hidden" asp-for="AvailableWeightKg" />
                    <input type="hidden" asp-for="AvailableLinearMeters" />
                    <input type="hidden" asp-for="AvailableVolumeM3" />
                    <input type="hidden" asp-for="CurrentLocation" />
                    <input type="hidden" asp-for="Destination" />
                    <input type="hidden" asp-for="AvailableFrom" />
                    <input type="hidden" asp-for="AvailableUntil" />
                    <input type="hidden" asp-for="VehicleType" />
                    <input type="hidden" asp-for="HasCooling" />
                    <input type="hidden" asp-for="HasTailLift" />
                    <input type="hidden" asp-for="Notes" />
                </form>
            </div>
        </div>
    </div>
</div>