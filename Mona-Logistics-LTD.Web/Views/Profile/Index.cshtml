@using Mona_Logistics_LTD.Web.ViewModels.User.Account.Profile;
@model ProfileViewModel

@{
    ViewData["Title"] = Localizer["ProfileTitle"];
}

<div class="container py-5">
    <!-- Welcome Banner -->
    <div class="profile-hero text-center mb-5">
        <div class="d-flex align-items-center justify-content-center gap-3 mb-3">
            <i class="bi bi-truck display-4" style="color: var(--logistics-accent);"></i>
            <i class="bi bi-person-badge display-4" style="color: rgba(255,255,255,0.4);"></i>
        </div>
        <h1 class="display-4" style="color: white;">@Localizer["WelcomeBack"] @Model.FirstName!</h1>
        <div class="accent-line mx-auto"></div>
        <p class="mt-3" style="color: rgba(255,255,255,0.6);">@Localizer["ProfileSubtitle"]</p>
    </div>

    <div class="row g-5">
        <!-- User Info -->
        <div class="col-lg-4">
            <div class="logistics-card text-center p-4">
                <div class="mb-4">
                    <div style="width: 120px; height: 120px; background: linear-gradient(135deg, rgba(212,160,23,0.2), rgba(212,160,23,0.05)); border-radius: 50%; display: inline-flex; align-items: center; justify-content: center; border: 2px solid rgba(212,160,23,0.3);">
                        <i class="bi bi-person display-1" style="color: var(--logistics-accent);"></i>
                    </div>
                </div>
                <h3 class="fw-bold" style="color: white;">@Model.FirstName @Model.LastName</h3>
                <div class="accent-line mx-auto" style="width: 40px;"></div>

                <div class="mt-4 text-start" style="word-wrap: break-word; overflow-wrap: break-word;">
                    <div class="mb-3">
                        <small style="color: rgba(255,255,255,0.4);">@Localizer["Email"]</small>
                        <p class="mb-0" style="word-wrap: break-word; overflow-wrap: break-word; color: rgba(255,255,255,0.8);"><i class="bi bi-envelope me-2" style="color: var(--logistics-accent);"></i> @Model.Email</p>
                    </div>
                    <div class="mb-3">
                        <small style="color: rgba(255,255,255,0.4);">@Localizer["Address"]</small>
                        <p class="mb-0" style="word-wrap: break-word; overflow-wrap: break-word; color: rgba(255,255,255,0.8);"><i class="bi bi-geo-alt me-2" style="color: var(--logistics-accent);"></i> @(string.IsNullOrEmpty(Model.Address) ? Localizer["NoAddress"] : Model.Address)</p>
                    </div>
                    <div>
                        <small style="color: rgba(255,255,255,0.4);">@Localizer["MemberSince"]</small>
                        <p class="mb-0" style="color: rgba(255,255,255,0.8);"><i class="bi bi-calendar-heart me-2" style="color: var(--logistics-accent);"></i> @Localizer["LoyalMember"]</p>
                    </div>
                </div>

                <hr class="my-4" style="border-color: rgba(212, 160, 23, 0.15);">

                <form asp-controller="Account" asp-action="Logout" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn-logistics-primary w-100">
                        <i class="bi bi-box-arrow-right me-2"></i> @Localizer["Logout"]
                    </button>
                </form>
            </div>
        </div>

        <!-- Messages Section -->
        <div class="col-lg-8">
            <div class="logistics-card p-4">
                <div class="d-flex gap-3 border-bottom pb-3 mb-4" style="border-color: rgba(212, 160, 23, 0.15);">
                    <button class="btn-logistics-primary active-tab px-3 py-2" id="systemTabBtn" style="border-radius: 8px; font-size: 0.9rem;">
                        <i class="bi bi-megaphone me-1"></i> @Localizer["SystemMessages"]
                        @if (Model.SystemInbox.Count(x => !x.IsRead) > 0)
                        {
                            <span class="badge ms-1" style="background: var(--logistics-accent); color: var(--logistics-primary-dark);">@Model.SystemInbox.Count(x => !x.IsRead)</span>
                        }
                    </button>
                    <button class="btn-logistics-outline px-3 py-2" id="contactTabBtn" style="border-radius: 8px; font-size: 0.9rem;">
                        <i class="bi bi-envelope-paper me-1"></i> @Localizer["ContactMessages"]
                        @if (Model.ContactMessages?.Count(x => !x.IsRead) > 0)
                        {
                            <span class="badge ms-1" style="background: var(--logistics-accent); color: var(--logistics-primary-dark);">@Model.ContactMessages.Count(x => !x.IsRead)</span>
                        }
                    </button>
                </div>

                <!-- System Messages -->
                <div id="systemMessagesPanel">
                    @if (Model.SystemInbox == null || !Model.SystemInbox.Any())
                    {
                        <div class="text-center py-5">
                            <i class="bi bi-envelope-open display-4" style="color: rgba(255,255,255,0.2);"></i>
                            <p class="mt-3" style="color: rgba(255,255,255,0.6);">@Localizer["NoSystemMessages"]</p>
                            <p class="small" style="color: rgba(255,255,255,0.3);">@Localizer["SystemMessagesInfo"]</p>
                        </div>
                    }
                    else
                    {
                        <div class="messages-stack">
                            @foreach (var message in Model.SystemInbox.OrderByDescending(x => x.CreatedOn))
                            {
                                <div class="message-item mb-4 p-3" style="background: rgba(255,255,255,0.03); border-radius: 12px; border: 1px solid rgba(255,255,255,0.05); transition: all 0.3s ease;">
                                    <a asp-controller="Profile" asp-action="SystemMessageDetails" asp-route-id="@message.Id" class="message-link" style="text-decoration: none; color: inherit; display: block;">
                                        <div class="d-flex justify-content-between align-items-start">
                                            <div class="d-flex gap-3 align-items-center">
                                                <i class="bi bi-megaphone" style="color: var(--logistics-accent); font-size: 1.5rem;"></i>
                                                <div>
                                                    <h6 class="fw-bold mb-0" style="color: white;">@message.Title</h6>
                                                    <small style="color: rgba(255,255,255,0.4);">@message.CreatedOn.ToLocalTime().ToString("dd MMM yyyy")</small>
                                                </div>
                                            </div>
                                            @if (!message.IsRead)
                                            {
                                                <span class="badge" style="background: var(--logistics-accent); color: var(--logistics-primary-dark);">@Localizer["New"]</span>
                                            }
                                        </div>
                                        <p class="mt-2 mb-0 small" style="color: rgba(255,255,255,0.5); word-wrap: break-word; overflow-wrap: break-word;">@(message.Description.Length > 100 ? message.Description.Substring(0, 100) + "..." : message.Description)</p>
                                        <div class="mt-2">
                                            <span style="color: var(--logistics-accent); font-weight: 500;">@Localizer["ReadMore"] <i class="bi bi-arrow-right"></i></span>
                                        </div>
                                    </a>
                                </div>
                            }
                        </div>
                    }
                </div>

                <!-- Contact Messages -->
                <div id="contactMessagesPanel" style="display: none;">
                    @if (Model.ContactMessages == null || !Model.ContactMessages.Any())
                    {
                        <div class="text-center py-5">
                            <i class="bi bi-envelope-paper display-4" style="color: rgba(255,255,255,0.2);"></i>
                            <p class="mt-3" style="color: rgba(255,255,255,0.6);">@Localizer["NoContactMessages"]</p>
                            <p class="small" style="color: rgba(255,255,255,0.3);">@Localizer["WriteFirstMessage"]</p>
                            <a asp-controller="ContactMessage" asp-action="Index" class="btn-logistics-primary mt-2" style="padding: 10px 24px;">
                                <i class="bi bi-pencil me-1"></i> @Localizer["WriteMessage"]
                            </a>
                        </div>
                    }
                    else
                    {
                        <div class="messages-stack">
                            @foreach (var message in Model.ContactMessages.OrderByDescending(x => x.CreatedOn))
                            {
                                <div class="message-item mb-4 p-3" style="background: rgba(255,255,255,0.03); border-radius: 12px; border: 1px solid rgba(255,255,255,0.05);">
                                    <a asp-controller="Profile" asp-action="ContactMessageDetails" asp-route-id="@message.Id" class="message-link" style="text-decoration: none; color: inherit; display: block;">
                                        <div class="d-flex justify-content-between align-items-start">
                                            <div class="d-flex gap-3 align-items-center">
                                                <i class="bi bi-chat" style="color: var(--logistics-accent); font-size: 1.5rem;"></i>
                                                <div>
                                                    <h6 class="fw-bold mb-0" style="color: white;">@message.Subject</h6>
                                                    <small style="color: rgba(255,255,255,0.4);">@message.CreatedOn.ToLocalTime().ToString("dd MMM yyyy")</small>
                                                </div>
                                            </div>
                                            @if (!string.IsNullOrEmpty(message.Response))
                                            {
                                                <span class="badge" style="background: rgba(212, 160, 23, 0.2); color: var(--logistics-accent);">@Localizer["Replied"]</span>
                                            }
                                            else
                                            {
                                                <span class="badge" style="background: rgba(255,255,255,0.05); color: rgba(255,255,255,0.4);">@Localizer["Waiting"]</span>
                                            }
                                        </div>
                                        <p class="mt-2 mb-0 small" style="color: rgba(255,255,255,0.5); word-wrap: break-word; overflow-wrap: break-word;">@(message.Message.Length > 100 ? message.Message.Substring(0, 100) + "..." : message.Message)</p>
                                        <div class="mt-2">
                                            <span style="color: var(--logistics-accent); font-weight: 500;">@Localizer["ReadMore"] <i class="bi bi-arrow-right"></i></span>
                                        </div>
                                    </a>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        const systemTab = document.getElementById('systemTabBtn');
        const contactTab = document.getElementById('contactTabBtn');
        const systemPanel = document.getElementById('systemMessagesPanel');
        const contactPanel = document.getElementById('contactMessagesPanel');

        function setActiveTab(active, inactive) {
            active.className = 'btn-logistics-primary active-tab px-3 py-2';
            inactive.className = 'btn-logistics-outline px-3 py-2';
        }

        systemTab.onclick = function() {
            setActiveTab(systemTab, contactTab);
            systemPanel.style.display = 'block';
            contactPanel.style.display = 'none';
        };

        contactTab.onclick = function() {
            setActiveTab(contactTab, systemTab);
            systemPanel.style.display = 'none';
            contactPanel.style.display = 'block';
        };
    });
</script>