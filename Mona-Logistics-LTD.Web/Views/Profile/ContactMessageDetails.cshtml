@using Mona_Logistics_LTD.Web.ViewModels.Admin.Message
@model ContactMessageDetailsViewModel

@{
    ViewData["Title"] = Localizer["ContactMessageTitle"];
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <a asp-controller="Profile" asp-action="Index" class="btn-logistics-outline mb-4" style="padding: 8px 20px;">
                <i class="bi bi-arrow-left me-1"></i> @Localizer["BackToProfile"]
            </a>

            <div class="logistics-card p-4">
                <!-- Your Message Section -->
                <div class="mb-4">
                    <div class="d-flex align-items-center gap-2 mb-3">
                        <i class="bi bi-envelope-paper" style="color: var(--logistics-accent);"></i>
                        <h5 class="mb-0 fw-bold">@Localizer["YourMessage"]</h5>
                    </div>

                    <div class="logistics-badge mb-3">
                        <i class="bi bi-clock me-1"></i>
                        @Model.CreatedOn.ToLocalTime().ToString("dd MMM yyyy · HH:mm")
                    </div>

                    <div class="message-content p-3" style="background: rgba(212, 160, 23, 0.05); border-left: 4px solid var(--logistics-accent); border-radius: 12px; word-wrap: break-word; overflow-wrap: break-word;">
                        <h3 class="fw-bold mb-3" style="color: white;">@Model.Subject</h3>
                        <p class="mb-0" style="white-space: pre-wrap; word-wrap: break-word; overflow-wrap: break-word; color: rgba(255,255,255,0.85);">@Model.Message</p>
                    </div>
                </div>

                <!-- Reply Section -->
                @if (!string.IsNullOrEmpty(Model.Response))
                {
                    <div class="mb-4">
                        <div class="d-flex align-items-center gap-2 mb-3">
                            <i class="bi bi-reply-all-fill" style="color: var(--logistics-accent);"></i>
                            <h5 class="mb-0 fw-bold">@Localizer["ReplyFromTeam"]</h5>
                        </div>

                        <div class="logistics-badge mb-3">
                            <i class="bi bi-calendar-check me-1"></i>
                            @Model.RespondedOnFormatted
                            @if (!string.IsNullOrEmpty(Model.RespondedByName))
                            {
                                <span class="ms-2">
                                    <i class="bi bi-person me-1"></i> @Model.RespondedByName
                                </span>
                            }
                        </div>

                        <div class="message-content p-3" style="background: rgba(212, 160, 23, 0.08); border-left: 4px solid var(--logistics-accent); border-radius: 12px; word-wrap: break-word; overflow-wrap: break-word;">
                            <p style="white-space: pre-wrap; word-wrap: break-word; overflow-wrap: break-word; color: rgba(255,255,255,0.85);">@Model.Response</p>
                        </div>
                    </div>
                }
                else
                {
                    <div class="text-center py-5 logistics-card" style="background: rgba(255,255,255,0.02);">
                        <i class="bi bi-hourglass-split display-4" style="color: rgba(255,255,255,0.3);"></i>
                        <p class="mt-3 mb-0 fw-semibold" style="color: rgba(255,255,255,0.7);">@Localizer["WaitingForReply"]</p>
                        <p class="small" style="color: rgba(255,255,255,0.4);">@Localizer["ReplySoon"]</p>
                    </div>
                }

                <hr class="my-4" style="border-color: rgba(212, 160, 23, 0.15);">

                <div class="d-flex justify-content-center gap-2 flex-wrap">
                    <a asp-controller="Profile" asp-action="Index" class="btn-logistics-primary">
                        <i class="bi bi-person-badge me-1"></i> @Localizer["BackToProfile"]
                    </a>
                    @if (string.IsNullOrEmpty(Model.Response))
                    {
                        <a asp-controller="ContactMessage" asp-action="Index" class="btn-logistics-outline">
                            <i class="bi bi-pencil me-1"></i> @Localizer["WriteNewMessage"]
                        </a>
                    }
                </div>
            </div>
        </div>
    </div>
</div>