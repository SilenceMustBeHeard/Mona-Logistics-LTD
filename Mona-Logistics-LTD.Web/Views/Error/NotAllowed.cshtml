

@{
    ViewData["Title"] = Localizer["NotAllowedTitle"];
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="logistics-card p-5 text-center">
                <div class="error-icon-wrapper mb-4">
                    <i class="bi bi-shield-lock-fill display-1" style="color: #e63946;"></i>
                </div>

                <div class="error-badge mb-3">
                    <span class="badge-logistics" style="background: rgba(230,57,70,0.15); color: #e63946; border-color: rgba(230,57,70,0.3);">
                        <i class="bi bi-shield-exclamation me-1"></i> 403 - @Localizer["NotAllowedTitle"]
                    </span>
                </div>

                <h1 class="display-4 fw-bold mb-3" style="color: #e63946;">
                    @Localizer["NotAllowedTitle"]
                </h1>

                <p class="text-muted mb-4">@Localizer["NotAllowedDesc"]</p>

                <div class="warning-box p-4 mb-4" style="background: rgba(230,57,70,0.05); border-radius: 12px; border-left: 4px solid #e63946;">
                    <div class="d-flex align-items-center gap-3">
                        <i class="bi bi-exclamation-octagon-fill text-danger fs-1"></i>
                        <div class="text-start">
                            <h6 class="mb-1 fw-bold" style="color: white;">@Localizer["RestrictedArea"]</h6>
                            <p class="mb-0 small text-muted">@Localizer["RestrictedDesc"]</p>
                        </div>
                    </div>
                </div>

                <div class="d-flex justify-content-center gap-3 flex-wrap">
                    <a asp-controller="Home" asp-action="Index" class="btn-logistics-primary">
                        <i class="bi bi-house-door me-2"></i> @Localizer["ReturnHome"]
                    </a>
                    <a asp-controller="Account" asp-action="Login" class="btn-logistics-outline">
                        <i class="bi bi-box-arrow-in-right me-2"></i> @Localizer["Login"]
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>