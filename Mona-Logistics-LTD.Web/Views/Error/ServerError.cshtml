@{
    ViewData["Title"] = Localizer["ServerErrorTitle"];
}

<div class="error-page-wrapper">
    <div class="container py-5">
        <div class="row justify-content-center">
            <div class="col-md-8 col-lg-6">
                <div class="error-card text-center p-5">
                    <!-- Warning Icon -->
                    <div class="error-icon mb-4">
                        <i class="bi bi-exclamation-triangle" style="font-size: 4rem; color: #e63946;"></i>
                    </div>

                    <div class="error-badge mb-3">
                        <span class="badge-logistics" style="background: rgba(230, 57, 70, 0.15); color: #e63946; border-color: rgba(230, 57, 70, 0.3);">
                            <i class="bi bi-server me-1"></i> 500 - @Localizer["ServerErrorBadge"]
                        </span>
                    </div>

                    <h1 class="display-1 fw-bold" style="color: #e63946;">500</h1>
                    <h2 class="error-title">@Localizer["ServerErrorTitle"]</h2>
                    <p class="error-description">@Localizer["ServerErrorDesc"]</p>

                    <div class="auto-rescue mt-4 p-3" style="background: rgba(255,255,255,0.03); border-radius: 12px; border: 1px solid rgba(255,255,255,0.05);">
                        <div class="rescue-text" style="color: rgba(255,255,255,0.6); font-size: 0.9rem;">
                            <i class="bi bi-arrow-repeat me-2" style="animation: spin 1s linear infinite;"></i>
                            @Localizer["AutoRescueText"]
                        </div>
                    </div>

                    <div class="action-buttons d-flex justify-content-center gap-3 flex-wrap mt-4">
                        <a asp-controller="Home" asp-action="Index" class="btn-logistics-primary">
                            <i class="bi bi-house-door me-2"></i> @Localizer["ReturnHome"]
                        </a>
                        <button onclick="location.reload()" class="btn-logistics-outline">
                            <i class="bi bi-arrow-repeat me-2"></i> @Localizer["TryAgain"]
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    @@keyframes spin {
        from {
            transform: rotate(0deg);
        }

        to {
            transform: rotate(360deg);
        }
    }
</style>