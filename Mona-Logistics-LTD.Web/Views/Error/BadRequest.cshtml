@{
    ViewData["Title"] = Localizer["BadRequestTitle"];
}

<div class="error-page-wrapper">
    <div class="container py-5">
        <div class="row justify-content-center">
            <div class="col-md-8 col-lg-6">
                <div class="error-card text-center p-5">
                    <!-- Error Icon -->
                    <div class="error-icon mb-4">
                        <i class="bi bi-exclamation-triangle-fill" style="font-size: 4rem; color: var(--logistics-accent);"></i>
                    </div>

                    <div class="error-badge mb-3">
                        <span class="badge-logistics">
                            <i class="bi bi-shield-exclamation me-1"></i> 400 - @Localizer["BadRequestBadge"]
                        </span>
                    </div>

                    <h1 class="display-1 fw-bold" style="color: var(--logistics-accent);">400</h1>
                    <h2 class="error-title">@Localizer["BadRequestTitle"]</h2>
                    <p class="error-description">@Localizer["BadRequestDesc"]</p>

                    <div class="action-buttons d-flex justify-content-center gap-3 flex-wrap mt-4">
                        <a asp-controller="Home" asp-action="Index" class="btn-logistics-primary">
                            <i class="bi bi-house-door me-2"></i> @Localizer["ReturnHome"]
                        </a>
                        <button onclick="history.back()" class="btn-logistics-outline">
                            <i class="bi bi-arrow-left me-2"></i> @Localizer["GoBack"]
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>