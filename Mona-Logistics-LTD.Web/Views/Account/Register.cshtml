@using Mona_Logistics_LTD.Web.ViewModels.User.Account.Profile
@model RegisterViewModel
@{
    ViewData["Title"] = "Регистрация - Mona Logistics";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="logistics-card">
                <div class="text-center mb-4">
                    <div class="login-icon">📋</div>
                    <h1 class="h3 mb-2">@Localizer["RegisterTitle"]</h1>
                    <p class="text-muted">@Localizer["RegisterSubtitle"]</p>
                    <div class="accent-line mx-auto"></div>
                </div>

                <form asp-action="Register" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="FirstName" class="form-label fw-semibold">@Localizer["FirstName"]</label>
                            <input asp-for="FirstName" class="form-control logistics-input" placeholder="Иван" />
                            <span asp-validation-for="FirstName" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="LastName" class="form-label fw-semibold">@Localizer["LastName"]</label>
                            <input asp-for="LastName" class="form-control logistics-input" placeholder="Иванов" />
                            <span asp-validation-for="LastName" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-3 mt-3">
                        <label asp-for="Email" class="form-label fw-semibold">@Localizer["EmailLabel"]</label>
                        <input asp-for="Email" class="form-control logistics-input" placeholder="ivan.ivanov@example.com" />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="AlternateEmail" class="form-label fw-semibold">@Localizer["AlternateEmail"]</label>
                        <input asp-for="AlternateEmail" class="form-control logistics-input" placeholder="резервен имейл" />
                        <span asp-validation-for="AlternateEmail" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Address" class="form-label fw-semibold">@Localizer["Address"]</label>
                        <input asp-for="Address" class="form-control logistics-input" placeholder="гр. София, ул. Примерна 1" />
                        <span asp-validation-for="Address" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Password" class="form-label fw-semibold">@Localizer["PasswordLabel"]</label>
                        <input asp-for="Password" type="password" class="form-control logistics-input" placeholder="••••••••" />
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="ConfirmPassword" class="form-label fw-semibold">@Localizer["ConfirmPasswordLabel"]</label>
                        <input asp-for="ConfirmPassword" type="password" class="form-control logistics-input" placeholder="••••••••" />
                        <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                    </div>

                    <button type="submit" class="btn-logistics-primary w-100 py-2">@Localizer["CreateAccountButton"]</button>

                    <div class="text-center mt-3">
                        <span class="text-muted small">@Localizer["AlreadyHaveAccount"]</span>
                        <a asp-action="Login" class="text-link ms-1">@Localizer["Login"]</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}