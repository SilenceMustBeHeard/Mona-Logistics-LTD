@using Mona_Logistics_LTD.Web.ViewModels.User.Account.Profile
@model ForgotPasswordViewModel
@{
    ViewData["Title"] = "Забравена парола - Mona Logistics";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="logistics-card">
                <div class="text-center mb-4">
                    <div class="login-icon">🔑</div>
                    <h1 class="h3 mb-2">@Localizer["ForgotPasswordTitle"]</h1>
                    <p class="text-muted">@Localizer["ForgotPasswordSubtitle"]</p>
                    <div class="accent-line mx-auto"></div>
                </div>

                <form asp-action="ForgotPassword" method="post" class="mt-4">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <div class="mb-4">
                        <label asp-for="Email" class="form-label fw-semibold">@Localizer["EmailLabel"]</label>
                        <input asp-for="Email" class="form-control logistics-input" placeholder="office@monalogistics.com" />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <button type="submit" class="btn-logistics-primary w-100 py-2 mb-3">@Localizer["SendResetLink"]</button>

                    <div class="text-center">
                        <a asp-action="Login" class="text-link">@Localizer["BackToLoginLink"]</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}