@{
    ViewData["Title"] = "Паролата е променена - Mona Logistics";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="logistics-card text-center">
                <div class="confirmation-icon">✓</div>
                <h1 class="h3 mb-3">@Localizer["PasswordResetSuccess"]</h1>
                <div class="accent-line mx-auto mb-4"></div>
                <a asp-action="Login" class="btn-logistics-primary w-100 py-2">@Localizer["LoginNow"]</a>
            </div>
        </div>
    </div>
</div>