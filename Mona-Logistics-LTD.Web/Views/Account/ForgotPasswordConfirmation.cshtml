@{
    ViewData["Title"] = "Заявка за възстановяване - Mona Logistics";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="logistics-card text-center">
                <div class="confirmation-icon">📧</div>
                <h1 class="h3 mb-3">Проверете имейла си</h1>
                <div class="accent-line mx-auto mb-4"></div>
                <p class="text-muted mb-4">
                    Изпратихме ви инструкции за възстановяване на паролата на имейл адреса, който сте предоставили.
                </p>
                <a asp-action="Login" class="btn-logistics-primary w-100 py-2">
                    Връщане към входа
                </a>
            </div>
        </div>
    </div>
</div>