@using Mona_Logistics_LTD.Web.ViewModels.Account
@model ResetPasswordViewModel
@{
    ViewData["Title"] = "Нова парола - Mona Logistics";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="logistics-card">
                <div class="text-center mb-4">
                    <div class="login-icon">🔄</div>
                    <h1 class="h3 mb-2">Създаване на нова парола</h1>
                    <p class="text-muted">Въведете новата си парола</p>
                    <div class="accent-line mx-auto"></div>
                </div>

                <form asp-action="ResetPassword" method="post">
                    @Html.AntiForgeryToken()

                    <input type="hidden" asp-for="Token" />
                    <input type="hidden" asp-for="Email" />

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="Password" class="form-label fw-semibold">Нова парола</label>
                        <input asp-for="Password" type="password" class="form-control logistics-input" placeholder="••••••••" />
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="ConfirmPassword" class="form-label fw-semibold">Потвърди парола</label>
                        <input asp-for="ConfirmPassword" type="password" class="form-control logistics-input" placeholder="••••••••" />
                        <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                    </div>

                    <button type="submit" class="btn-logistics-primary w-100 py-2 mb-3">
                        Запазване на паролата
                    </button>

                    <div class="text-center">
                        <a asp-action="Login" class="text-link">Връщане към входа</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}