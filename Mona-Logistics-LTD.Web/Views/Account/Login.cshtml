@using Mona_Logistics_LTD.Web.ViewModels.User.Account.Profile
@model LoginViewModel
@{
    ViewData["Title"] = "Вход - Mona Logistics";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="logistics-card">
                <div class="text-center mb-4">
                    <div class="login-icon">🔐</div>
                    <h1 class="h3 mb-2">@Localizer["LoginTitle"]</h1>
                    <p class="text-muted">@Localizer["LoginSubtitle"]</p>
                    <div class="accent-line mx-auto"></div>
                </div>

                <form asp-action="Login" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label fw-semibold">@Localizer["EmailLabel"]</label>
                        <input asp-for="Email" class="form-control logistics-input" placeholder="office@monalogistics.com" />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Password" class="form-label fw-semibold">@Localizer["PasswordLabel"]</label>
                        <input asp-for="Password" type="password" class="form-control logistics-input" placeholder="Вашата парола" />
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <div class="form-check mb-4">
                        <input asp-for="RememberMe" class="form-check-input" />
                        <label asp-for="RememberMe" class="form-check-label">@Localizer["RememberMe"]</label>
                    </div>

                    <button type="submit" class="btn-logistics-primary w-100 py-2 mb-3">@Localizer["LoginButton"]</button>

                    <div class="text-center mt-3">
                        <a asp-action="ForgotPassword" class="text-link">@Localizer["ForgotPasswordLink"]</a>
                    </div>
                    <div class="text-center mt-2">
                        <span class="text-muted small">@Localizer["DontHaveAccount"]</span>
                        <a asp-action="Register" class="text-link ms-1">@Localizer["Register"]</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}