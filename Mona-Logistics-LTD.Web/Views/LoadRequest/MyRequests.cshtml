@using Mona_Logistics_LTD.Data.Common.Enums
@using Mona_Logistics_LTD.Data.Models.Loads
@model IEnumerable<LoadRequest>

@{
    ViewData["Title"] = Localizer["MyRequestsTitle"];
}

<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap">
        <div>
            <h1 style="color: white;">@Localizer["MyRequestsTitle"]</h1>
            <p style="color: rgba(255,255,255,0.6);">@Localizer["MyRequestsSubtitle"]</p>
        </div>
        <a asp-action="Create" class="btn-logistics-primary">
            <i class="bi bi-plus-lg me-2"></i> @Localizer["NewRequest"]
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="text-center py-5 logistics-card">
            <i class="bi bi-box-seam display-4" style="color: rgba(255,255,255,0.2);"></i>
            <p class="mt-3" style="color: rgba(255,255,255,0.6);">@Localizer["NoRequests"]</p>
            <a asp-action="Create" class="btn-logistics-primary mt-3">
                <i class="bi bi-plus-lg me-2"></i> @Localizer["CreateFirstRequest"]
            </a>
        </div>
    }
    else
    {
        <div class="table-container">
            <table class="table">
                <thead>
                    <tr>
                        <th>@Localizer["CargoName"]</th>
                        <th>@Localizer["PickupAddress"]</th>
                        <th>@Localizer["DeliveryAddress"]</th>
                        <th>@Localizer["PreferredPickupDate"]</th>
                        <th>@Localizer["Status"]</th>
                        <th>@Localizer["Actions"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var request in Model)
                    {
                        <tr>
                            <td><strong>@request.CargoName</strong></td>
                            <td>@request.PickupAddress</td>
                            <td>@request.DeliveryAddress</td>
                            <td>@request.PreferredPickupDate.ToString("dd MMM yyyy")</td>
                            <td>
                                <span class="status-badge @(request.Status switch
                                      {
                                          LoadRequestStatus.Pending => "status-pending",
                                          LoadRequestStatus.UnderReview => "status-underreview",
                                          LoadRequestStatus.Offered => "status-offered",
                                          LoadRequestStatus.Accepted => "status-accepted",
                                          LoadRequestStatus.InProgress => "status-inprogress",
                                          LoadRequestStatus.Completed => "status-completed",
                                          LoadRequestStatus.Cancelled => "status-cancelled",
                                          _ => ""
                                      })">
                                    @(request.Status switch
                                    {
                                        LoadRequestStatus.Pending => Localizer["Pending"],
                                        LoadRequestStatus.UnderReview => Localizer["UnderReview"],
                                        LoadRequestStatus.Offered => Localizer["Offered"],
                                        LoadRequestStatus.Accepted => Localizer["Accepted"],
                                        LoadRequestStatus.InProgress => Localizer["InProgress"],
                                        LoadRequestStatus.Completed => Localizer["Completed"],
                                        LoadRequestStatus.Cancelled => Localizer["Cancelled"],
                                        _ => request.Status.ToString()
                                    })
                                </span>
                            </td>
                            <td>
                                <div class="d-flex gap-2 flex-wrap">
                                    <a asp-action="Details" asp-route-id="@request.Id" class="btn-sm btn-logistics-outline">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    @if (request.Status == LoadRequestStatus.Pending || request.Status == LoadRequestStatus.UnderReview)
                                    {
                                        <a asp-action="Edit" asp-route-id="@request.Id" class="btn-sm btn-logistics-outline">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <form asp-action="Cancel" asp-route-id="@request.Id" method="post" style="display:inline;">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn-sm btn-logistics-outline" style="border-color: #e63946; color: #e63946;" onclick="return confirm('@Localizer["CancelConfirm"]')">
                                                <i class="bi bi-x-lg"></i>
                                            </button>
                                        </form>
                                    }
                                    @if (request.Status == LoadRequestStatus.Offered)
                                    {
                                        <a asp-controller="Offer" asp-action="Index" asp-route-requestId="@request.Id" class="btn-sm btn-logistics-primary">
                                            <i class="bi bi-file-earmark-text"></i> @Localizer["ViewOffers"]
                                        </a>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>