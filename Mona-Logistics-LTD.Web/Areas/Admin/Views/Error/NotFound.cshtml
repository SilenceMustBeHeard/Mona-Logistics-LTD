@using Mona_Logistics_LTD.Services.Localizer.Interfaces
@inject IJsonLocalizer Localizer


@{
    ViewData["Title"] = Localizer["NotFoundTitle"];
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="logistics-card p-5 text-center">
                <div class="error-icon-wrapper mb-4">
                    <i class="bi bi-compass display-1" style="color: var(--logistics-accent);"></i>
                </div>

                <div class="error-badge mb-3">
                    <span class="badge-logistics">
                        <i class="bi bi-map me-1"></i> 404 - @Localizer["NotFoundTitle"]
                    </span>
                </div>

                <h1 class="display-1 fw-bold mb-0" style="color: var(--logistics-accent);">404</h1>
                <h2 class="h3 fw-bold mb-3" style="color: white;">@Localizer["NotFoundTitle"]</h2>

                <p class="text-muted mb-4">@Localizer["NotFoundDesc"]</p>

                <div class="popular-links p-3 mb-4" style="background: rgba(255,255,255,0.02); border-radius: 12px; border: 1px solid rgba(212,160,23,0.08);">
                    <h6 class="text-accent mb-2">
                        <i class="bi bi-star me-1"></i> @Localizer["PopularDestinations"]
                    </h6>
                    <div class="d-flex gap-2 justify-content-center flex-wrap">
                        <a asp-controller="Home" asp-action="Index" class="badge-logistics text-decoration-none">@Localizer["Home"]</a>
                        <a asp-controller="Services" asp-action="Index" class="badge-logistics text-decoration-none">@Localizer["Services"]</a>
                        <a asp-controller="Contact" asp-action="Index" class="badge-logistics text-decoration-none">@Localizer["Contact"]</a>
                    </div>
                </div>

                <div class="d-flex justify-content-center gap-3 flex-wrap">
                    <a asp-controller="Home" asp-action="Index" class="btn-logistics-primary">
                        <i class="bi bi-house-door me-2"></i> @Localizer["ReturnHome"]
                    </a>
                    <button onclick="history.back()" class="btn-logistics-outline">
                        <i class="bi bi-arrow-left me-2"></i> @Localizer["GoBack"]
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>