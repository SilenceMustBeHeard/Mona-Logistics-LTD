@using Mona_Logistics_LTD.Services.Localizer.Interfaces
@inject IJsonLocalizer Localizer

@{
    ViewData["Title"] = Localizer["NotAllowedTitle"];
}

<div class="error-page-wrapper">
    <div class="container py-5">
        <div class="row justify-content-center">
            <div class="col-md-8 col-lg-6">
                <div class="error-card text-center p-5">
                    <!-- Lock Icon -->
                    <div class="error-icon mb-4">
                        <i class="bi bi-lock-fill" style="font-size: 4rem; color: #e63946;"></i>
                    </div>

                    <div class="error-badge mb-3">
                        <span class="badge-logistics" style="background: rgba(230, 57, 70, 0.15); color: #e63946; border-color: rgba(230, 57, 70, 0.3);">
                            <i class="bi bi-shield-lock me-1"></i> 403 - @Localizer["NotAllowedBadge"]
                        </span>
                    </div>

                    <h1 class="display-1 fw-bold" style="color: #e63946;">403</h1>
                    <h2 class="error-title">@Localizer["NotAllowedTitle"]</h2>
                    <p class="error-description">@Localizer["NotAllowedDesc"]</p>

                    <div class="action-buttons d-flex justify-content-center gap-3 flex-wrap mt-4">
                        <a asp-controller="Home" asp-action="Index" class="btn-logistics-primary">
                            <i class="bi bi-house-door me-2"></i> @Localizer["ReturnHome"]
                        </a>
                        <a asp-controller="Account" asp-action="Login" class="btn-logistics-outline">
                            <i class="bi bi-box-arrow-in-right me-2"></i> @Localizer["Login"]
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>