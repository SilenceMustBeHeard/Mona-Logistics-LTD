@using Mona_Logistics_LTD.Services.Localizer.Interfaces
@inject IJsonLocalizer Localizer



@{
    ViewData["Title"] = Localizer["NotImplementedTitle"];
    string featureName = ViewBag.FeatureName ?? Localizer["DefaultFeatureName"];
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="logistics-card p-5 text-center">
                <div class="error-icon-wrapper mb-4">
                    <i class="bi bi-tools display-1" style="color: var(--logistics-warning, #e9c46a);"></i>
                </div>

                <div class="error-badge mb-3">
                    <span class="badge-logistics" style="background: rgba(233,196,106,0.15); color: #b8860b; border-color: rgba(233,196,106,0.3);">
                        <i class="bi bi-hammer me-1"></i> 501 - @Localizer["NotImplementedTitle"]
                    </span>
                </div>

                <h1 class="display-4 fw-bold mb-3" style="color: var(--logistics-warning, #e9c46a);">
                    @Localizer["NotImplementedTitle"]
                </h1>

                <p class="text-muted mb-2">@Localizer["NotImplementedDesc"] <strong>@featureName</strong> @Localizer["NotImplementedDesc2"]</p>

                <div class="progress-container mb-4">
                    <div class="progress-label d-flex justify-content-between mb-1">
                        <small class="text-muted">@Localizer["ProgressLabel"]</small>
                        <small class="text-accent" id="progressPercent">65%</small>
                    </div>
                    <div class="progress" style="height: 8px; border-radius: 20px; background: rgba(255,255,255,0.05);">
                        <div class="progress-bar" id="progressBar" role="progressbar" style="width: 65%; background: var(--logistics-accent); border-radius: 20px; transition: width 0.5s ease;"></div>
                    </div>
                    <div class="mt-2">
                        <small class="text-muted" id="progressStatus">@Localizer["InProgress"]</small>
                    </div>
                </div>

                <div class="d-flex justify-content-center gap-3 flex-wrap">
                    <a asp-controller="Home" asp-action="Index" class="btn-logistics-primary">
                        <i class="bi bi-house-door me-2"></i> @Localizer["ReturnHome"]
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        let progress = 65;
        const bar = document.getElementById('progressBar');
        const percent = document.getElementById('progressPercent');
        const status = document.getElementById('progressStatus');

        const messages = ['@Localizer["StatusPlanning"]', '@Localizer["StatusBuilding"]', '@Localizer["StatusTesting"]', '@Localizer["StatusFinalizing"]'];
        let idx = 0;

        const interval = setInterval(() => {
            if (progress < 100) {
                progress += Math.random() * 3 + 1;
                if (progress > 100) progress = 100;
                bar.style.width = progress + '%';
                percent.textContent = Math.floor(progress) + '%';
                if (Math.random() > 0.6) {
                    status.textContent = messages[idx % messages.length];
                    idx++;
                }
            } else {
                clearInterval(interval);
                status.textContent = '@Localizer["StatusReady"]';
            }
        }, 1500);
    });
</script>