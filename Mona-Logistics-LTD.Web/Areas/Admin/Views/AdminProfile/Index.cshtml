@using Mona_Logistics_LTD.Services.Localizer.Interfaces
@using Mona_Logistics_LTD.Web.ViewModels.User.Account.Profile
@model ProfileViewModel

@inject IJsonLocalizer Localizer

@{
    ViewData["Title"] = Localizer["AdminProfileTitle"];
}

<link rel="stylesheet" href="~/css/admin-profile.css" asp-append-version="true" />

<div class="container py-5">
    <div class="row g-4">
        <!-- Left Column - Profile Info -->
        <div class="col-lg-4">
            <div class="logistics-card text-center p-4">
                <div class="mb-4">
                    <div class="profile-avatar-wrapper">
                        <i class="bi bi-shield-lock"></i>
                    </div>
                </div>
                <h3 class="profile-name">@Model.FirstName @Model.LastName</h3>
                <div class="accent-line mx-auto" style="width: 40px;"></div>
                <span class="admin-badge">ADMINISTRATOR</span>

                <div class="mt-4 text-start">
                    <div class="profile-info-item">
                        <small>@Localizer["Email"]</small>
                        <p><i class="bi bi-envelope"></i> @Model.Email</p>
                    </div>
                    <div class="profile-info-item">
                        <small>@Localizer["Address"]</small>
                        <p><i class="bi bi-geo-alt"></i> @(string.IsNullOrEmpty(Model.Address) ? Localizer["NoAddress"] : Model.Address)</p>
                    </div>
                    <div class="profile-info-item">
                        <small>@Localizer["Role"]</small>
                        <p><i class="bi bi-shield-lock"></i> @Localizer["FullAccess"]</p>
                    </div>
                </div>

                <hr class="profile-divider">

                <form asp-controller="Account" asp-action="Logout" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn-logistics-primary w-100">
                        <i class="bi bi-box-arrow-right me-2"></i> @Localizer["Logout"]
                    </button>
                </form>
            </div>
        </div>

        <!-- Right Column - Messages -->
        <div class="col-lg-8">
            <div class="logistics-card p-4">
                <!-- Tabs -->
                <div class="profile-tabs">
                    <button class="profile-tab-btn active" id="systemTabBtn">
                        <i class="bi bi-megaphone"></i> @Localizer["SystemMessages"]
                        @if (Model.SystemInbox?.Count(x => !x.IsRead) > 0)
                        {
                            <span class="badge">@Model.SystemInbox.Count(x => !x.IsRead)</span>
                        }
                    </button>
                    <button class="profile-tab-btn" id="contactTabBtn">
                        <i class="bi bi-envelope-paper"></i> @Localizer["ContactMessages"]
                        @if (Model.ContactMessages?.Count(x => !x.IsReadByAdmin) > 0)
                        {
                            <span class="badge">@Model.ContactMessages.Count(x => !x.IsReadByAdmin)</span>
                        }
                    </button>
                </div>

                <!-- System Messages Panel -->
                <div id="systemMessagesPanel">
                    @if (Model.SystemInbox == null || !Model.SystemInbox.Any())
                    {
                        <div class="empty-state">
                            <i class="bi bi-envelope-open"></i>
                            <p>@Localizer["NoSystemMessages"]</p>
                            <p class="small">@Localizer["SystemMessagesInfo"]</p>
                        </div>
                    }
                    else
                    {
                        <div class="messages-stack">
                            @foreach (var message in Model.SystemInbox.OrderByDescending(x => x.CreatedOn))
                            {
                                <div class="message-item">
                                    <a asp-area="Admin" asp-controller="AdminProfile" asp-action="SystemMessageDetails" asp-route-id="@message.Id" class="message-link">
                                        <div class="d-flex justify-content-between align-items-start">
                                            <div class="d-flex gap-2 align-items-center">
                                                <i class="bi bi-megaphone message-icon"></i>
                                                <div>
                                                    <h6 class="message-title">@message.Title</h6>
                                                    <small class="message-date">@message.CreatedOn.ToLocalTime().ToString("dd MMM yyyy")</small>
                                                </div>
                                            </div>
                                            @if (!message.IsRead)
                                            {
                                                <span class="badge" style="background: #e63946; color: white;">@Localizer["New"]</span>
                                            }
                                        </div>
                                        <p class="message-preview">@(message.Description.Length > 100 ? message.Description.Substring(0, 100) + "..." : message.Description)</p>
                                        <div class="message-action">@Localizer["ReadMore"] <i class="bi bi-arrow-right"></i></div>
                                    </a>
                                </div>
                            }
                        </div>
                    }
                </div>

                <!-- Contact Messages Panel -->
                <div id="contactMessagesPanel" style="display: none;">
                    @if (Model.ContactMessages == null || !Model.ContactMessages.Any())
                    {
                        <div class="empty-state">
                            <i class="bi bi-envelope-paper"></i>
                            <p>@Localizer["NoContactMessages"]</p>
                            <p class="small">@Localizer["ContactMessagesInfo"]</p>
                        </div>
                    }
                    else
                    {
                        <div class="messages-stack">
                            @foreach (var message in Model.ContactMessages.OrderByDescending(x => x.CreatedOn))
                            {
                                <div class="message-item">
                                    <a asp-area="Admin" asp-controller="ContactMessageAdmin" asp-action="Details" asp-route-id="@message.Id" class="message-link">
                                        <div class="d-flex justify-content-between align-items-start">
                                            <div class="d-flex gap-2 align-items-center">
                                                <i class="bi bi-chat message-icon"></i>
                                                <div>
                                                    <h6 class="message-title">@message.Subject</h6>
                                                    <small class="message-date">@message.CreatedOn.ToLocalTime().ToString("dd MMM yyyy")</small>
                                                </div>
                                            </div>
                                            @if (!message.IsReadByAdmin)
                                            {
                                                <span class="badge" style="background: #e63946; color: white;">@Localizer["New"]</span>
                                            }
                                        </div>
                                        <p class="message-preview">@(message.Message.Length > 100 ? message.Message.Substring(0, 100) + "..." : message.Message)</p>
                                        <div class="message-action">@Localizer["ViewAndRespond"] <i class="bi bi-arrow-right"></i></div>
                                    </a>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        const systemTab = document.getElementById('systemTabBtn');
        const contactTab = document.getElementById('contactTabBtn');
        const systemPanel = document.getElementById('systemMessagesPanel');
        const contactPanel = document.getElementById('contactMessagesPanel');

        function setActiveTab(active) {
            if (active === 'system') {
                systemTab.className = 'profile-tab-btn active';
                contactTab.className = 'profile-tab-btn';
                systemPanel.style.display = 'block';
                contactPanel.style.display = 'none';
            } else {
                contactTab.className = 'profile-tab-btn active';
                systemTab.className = 'profile-tab-btn';
                systemPanel.style.display = 'none';
                contactPanel.style.display = 'block';
            }
        }

        systemTab.onclick = function() { setActiveTab('system'); };
        contactTab.onclick = function() { setActiveTab('contact'); };
    });
</script>