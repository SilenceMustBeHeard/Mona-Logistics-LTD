@using Mona_Logistics_LTD.Services.Localizer.Interfaces
@using Mona_Logistics_LTD.Web.ViewModels.User.Account.Profile
@model ProfileViewModel

@inject IJsonLocalizer Localizer

@{
    ViewData["Title"] = Localizer["AdminProfileTitle"];
}

<div class="container py-5">
    <div class="row g-4">
        <div class="col-lg-4">
            <div class="logistics-card text-center p-4">
                <div class="mb-4">
                    <div style="width: 120px; height: 120px; background: rgba(212,160,23,0.1); border-radius: 50%; display: inline-flex; align-items: center; justify-content: center; border: 2px solid rgba(212,160,23,0.2);">
                        <i class="bi bi-shield-lock display-1" style="color: var(--logistics-accent);"></i>
                    </div>
                </div>
                <h3 class="fw-bold" style="color: white;">@Model.FirstName @Model.LastName</h3>
                <div class="accent-line mx-auto" style="width: 40px;"></div>
                <span class="badge" style="background: var(--logistics-accent); color: var(--logistics-primary-dark); margin-top: 8px;">ADMINISTRATOR</span>

                <div class="mt-4 text-start">
                    <div class="mb-2">
                        <small style="color: rgba(255,255,255,0.4);">@Localizer["Email"]</small>
                        <p class="mb-0" style="color: rgba(255,255,255,0.8);"><i class="bi bi-envelope me-2 text-accent"></i> @Model.Email</p>
                    </div>
                    <div class="mb-2">
                        <small style="color: rgba(255,255,255,0.4);">@Localizer["Address"]</small>
                        <p class="mb-0" style="color: rgba(255,255,255,0.8);"><i class="bi bi-geo-alt me-2 text-accent"></i> @(string.IsNullOrEmpty(Model.Address) ? Localizer["NoAddress"] : Model.Address)</p>
                    </div>
                    <div>
                        <small style="color: rgba(255,255,255,0.4);">@Localizer["Role"]</small>
                        <p class="mb-0" style="color: rgba(255,255,255,0.8);"><i class="bi bi-shield-lock me-2 text-accent"></i> @Localizer["FullAccess"]</p>
                    </div>
                </div>

                <hr style="border-color: rgba(212,160,23,0.1);">

                <form asp-controller="Account" asp-action="Logout" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn-logistics-primary w-100">
                        <i class="bi bi-box-arrow-right me-2"></i> @Localizer["Logout"]
                    </button>
                </form>
            </div>
        </div>

        <div class="col-lg-8">
            <div class="logistics-card p-4">
                <div class="d-flex gap-2 border-bottom pb-3 mb-3" style="border-color: rgba(212,160,23,0.1);">
                    <button class="btn-logistics-primary active-tab px-3 py-2" id="systemTabBtn" style="border-radius: 8px; font-size: 0.9rem;">
                        <i class="bi bi-megaphone me-1"></i> @Localizer["SystemMessages"]
                        @if (Model.SystemInbox?.Count(x => !x.IsRead) > 0)
                        {
                            <span class="badge ms-1" style="background: #e63946; color: white;">@Model.SystemInbox.Count(x => !x.IsRead)</span>
                        }
                    </button>
                    <button class="btn-logistics-outline px-3 py-2" id="contactTabBtn" style="border-radius: 8px; font-size: 0.9rem;">
                        <i class="bi bi-envelope-paper me-1"></i> @Localizer["ContactMessages"]
                        @if (Model.ContactMessages?.Count(x => !x.IsReadByAdmin) > 0)
                        {
                            <span class="badge ms-1" style="background: #e63946; color: white;">@Model.ContactMessages.Count(x => !x.IsReadByAdmin)</span>
                        }
                    </button>
                </div>

                <div id="systemMessagesPanel">
                    @if (Model.SystemInbox == null || !Model.SystemInbox.Any())
                    {
                        <div class="text-center py-5">
                            <i class="bi bi-envelope-open display-4" style="color: rgba(255,255,255,0.1);"></i>
                            <p class="mt-3" style="color: rgba(255,255,255,0.5);">@Localizer["NoSystemMessages"]</p>
                            <p class="small" style="color: rgba(255,255,255,0.3);">@Localizer["SystemMessagesInfo"]</p>
                        </div>
                    }
                    else
                    {
                        <div class="messages-stack">
                            @foreach (var message in Model.SystemInbox.OrderByDescending(x => x.CreatedOn))
                            {
                                <div class="message-item mb-3 p-3 rounded-3" style="background: rgba(255,255,255,0.02); border: 1px solid rgba(255,255,255,0.04);">
                                    <a asp-area="Admin" asp-controller="AdminProfile" asp-action="SystemMessageDetails" asp-route-id="@message.Id" class="message-link" style="text-decoration: none; color: inherit; display: block;">
                                        <div class="d-flex justify-content-between align-items-start">
                                            <div class="d-flex gap-2 align-items-center">
                                                <i class="bi bi-megaphone" style="color: var(--logistics-accent);"></i>
                                                <div>
                                                    <h6 class="fw-bold mb-0" style="color: white;">@message.Title</h6>
                                                    <small style="color: rgba(255,255,255,0.3);">@message.CreatedOn.ToLocalTime().ToString("dd MMM yyyy")</small>
                                                </div>
                                            </div>
                                            @if (!message.IsRead)
                                            {
                                                <span class="badge" style="background: #e63946; color: white;">@Localizer["New"]</span>
                                            }
                                        </div>
                                        <p class="mt-2 mb-0 small" style="color: rgba(255,255,255,0.5);">@(message.Description.Length > 100 ? message.Description.Substring(0, 100) + "..." : message.Description)</p>
                                        <div class="mt-2">
                                            <span style="color: var(--logistics-accent); font-weight: 500;">@Localizer["ReadMore"] <i class="bi bi-arrow-right"></i></span>
                                        </div>
                                    </a>
                                </div>
                            }
                        </div>
                    }
                </div>

                <div id="contactMessagesPanel" style="display: none;">
                    @if (Model.ContactMessages == null || !Model.ContactMessages.Any())
                    {
                        <div class="text-center py-5">
                            <i class="bi bi-envelope-paper display-4" style="color: rgba(255,255,255,0.1);"></i>
                            <p class="mt-3" style="color: rgba(255,255,255,0.5);">@Localizer["NoContactMessages"]</p>
                            <p class="small" style="color: rgba(255,255,255,0.3);">@Localizer["ContactMessagesInfo"]</p>
                        </div>
                    }
                    else
                    {
                        <div class="messages-stack">
                            @foreach (var message in Model.ContactMessages.OrderByDescending(x => x.CreatedOn))
                            {
                                <div class="message-item mb-3 p-3 rounded-3" style="background: rgba(255,255,255,0.02); border: 1px solid rgba(255,255,255,0.04);">
                                    <a asp-area="Admin" asp-controller="ContactMessage" asp-action="Details" asp-route-id="@message.Id" class="message-link" style="text-decoration: none; color: inherit; display: block;">
                                        <div class="d-flex justify-content-between align-items-start">
                                            <div class="d-flex gap-2 align-items-center">
                                                <i class="bi bi-chat" style="color: var(--logistics-accent);"></i>
                                                <div>
                                                    <h6 class="fw-bold mb-0" style="color: white;">@message.Subject</h6>
                                                    <small style="color: rgba(255,255,255,0.3);">@message.CreatedOn.ToLocalTime().ToString("dd MMM yyyy")</small>
                                                </div>
                                            </div>
                                            @if (!message.IsReadByAdmin)
                                            {
                                                <span class="badge" style="background: #e63946; color: white;">@Localizer["New"]</span>
                                            }
                                        </div>
                                        <p class="mt-2 mb-0 small" style="color: rgba(255,255,255,0.5);">@(message.Message.Length > 100 ? message.Message.Substring(0, 100) + "..." : message.Message)</p>
                                        <div class="mt-2">
                                            <span style="color: var(--logistics-accent); font-weight: 500;">@Localizer["ViewAndRespond"] <i class="bi bi-arrow-right"></i></span>
                                        </div>
                                    </a>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        const systemTab = document.getElementById('systemTabBtn');
        const contactTab = document.getElementById('contactTabBtn');
        const systemPanel = document.getElementById('systemMessagesPanel');
        const contactPanel = document.getElementById('contactMessagesPanel');

        systemTab.onclick = function() {
            systemTab.className = 'btn-logistics-primary active-tab px-3 py-2';
            contactTab.className = 'btn-logistics-outline px-3 py-2';
            systemPanel.style.display = 'block';
            contactPanel.style.display = 'none';
        };

        contactTab.onclick = function() {
            contactTab.className = 'btn-logistics-primary active-tab px-3 py-2';
            systemTab.className = 'btn-logistics-outline px-3 py-2';
            systemPanel.style.display = 'none';
            contactPanel.style.display = 'block';
        };
    });
</script>