@using Mona_Logistics_LTD.Services.Localizer.Interfaces
@inject IJsonLocalizer Localizer

@{
    ViewData["Title"] = Localizer["AdminDashboardTitle"];
}

<div class="admin-dashboard">
    <!-- Hero Section -->
    <div class="dashboard-hero" data-aos="fade-down">
        <div class="dashboard-hero-content">
            <div class="hero-icon-wrapper">
                <i class="bi bi-shield-lock-fill"></i>
            </div>
            <h1 class="dashboard-hero-title">@Localizer["AdminDashboardTitle"]</h1>
            <div class="dashboard-hero-line"></div>
            <p class="dashboard-hero-subtitle">@Localizer["AdminDashboardSubtitle"]</p>
        </div>
    </div>

    <!-- Stats Cards -->
    <div class="dashboard-stats" data-aos="fade-up" data-aos-delay="100">
        <div class="stats-grid">
            <div class="stat-card">
                <div class="stat-icon">
                    <i class="bi bi-box-seam"></i>
                </div>
                <div class="stat-number" id="loadRequestsCount">0</div>
                <div class="stat-label">@Localizer["TotalRequests"]</div>
                <div class="stat-trend up">
                    <i class="bi bi-arrow-up"></i> 12%
                </div>
            </div>
            <div class="stat-card">
                <div class="stat-icon">
                    <i class="bi bi-people"></i>
                </div>
                <div class="stat-number" id="usersCount">0</div>
                <div class="stat-label">@Localizer["TotalUsers"]</div>
                <div class="stat-trend up">
                    <i class="bi bi-arrow-up"></i> 8%
                </div>
            </div>
            <div class="stat-card">
                <div class="stat-icon">
                    <i class="bi bi-truck"></i>
                </div>
                <div class="stat-number" id="trucksCount">0</div>
                <div class="stat-label">@Localizer["ActiveTrucks"]</div>
                <div class="stat-trend down">
                    <i class="bi bi-arrow-down"></i> 3%
                </div>
            </div>
            <div class="stat-card">
                <div class="stat-icon">
                    <i class="bi bi-envelope-paper"></i>
                </div>
                <div class="stat-number" id="messagesCount">0</div>
                <div class="stat-label">@Localizer["NewMessages"]</div>
                <div class="stat-trend up">
                    <i class="bi bi-arrow-up"></i> 24%
                </div>
            </div>
        </div>
    </div>

    <!-- Quick Actions Grid -->
    <div class="dashboard-actions" data-aos="fade-up" data-aos-delay="200">
        <h2 class="section-title">@Localizer["QuickActions"]</h2>
        <div class="actions-grid">
            <a asp-area="Admin" asp-controller="LoadRequest" asp-action="Index" class="action-card">
                <div class="action-icon">
                    <i class="bi bi-box-seam"></i>
                </div>
                <h5>@Localizer["LoadRequests"]</h5>
                <p>@Localizer["LoadRequestsDesc"]</p>
                <span class="action-arrow"><i class="bi bi-arrow-right"></i></span>
            </a>
            <a asp-area="Admin" asp-controller="UserManagement" asp-action="Index" class="action-card">
                <div class="action-icon">
                    <i class="bi bi-people"></i>
                </div>
                <h5>@Localizer["UserManagement"]</h5>
                <p>@Localizer["UserManagementDesc"]</p>
                <span class="action-arrow"><i class="bi bi-arrow-right"></i></span>
            </a>
            <a asp-area="Admin" asp-controller="SystemMessage" asp-action="Index" class="action-card">
                <div class="action-icon">
                    <i class="bi bi-megaphone"></i>
                </div>
                <h5>@Localizer["SystemMessages"]</h5>
                <p>@Localizer["SystemMessagesDesc"]</p>
                <span class="action-arrow"><i class="bi bi-arrow-right"></i></span>
            </a>
            <a asp-area="Admin" asp-controller="TruckManagement" asp-action="Index" class="action-card">
                <div class="action-icon">
                    <i class="bi bi-truck"></i>
                </div>
                <h5>@Localizer["FleetManagement"]</h5>
                <p>@Localizer["FleetManagementDesc"]</p>
                <span class="action-arrow"><i class="bi bi-arrow-right"></i></span>
            </a>
            <a asp-area="Admin" asp-controller="LoadRequest" asp-action="Index" class="action-card highlight">
                <div class="action-icon">
                    <i class="bi bi-file-earmark-text"></i>
                </div>
                <h5>@Localizer["PendingRequests"]</h5>
                <p>@Localizer["PendingRequestsDesc"]</p>
                <span class="action-arrow"><i class="bi bi-arrow-right"></i></span>
                <span class="action-badge" id="pendingCount">0</span>
            </a>
            <a asp-area="Admin" asp-controller="ContactMessage" asp-action="AdminInbox" class="action-card">
                <div class="action-icon">
                    <i class="bi bi-envelope-paper"></i>
                </div>
                <h5>@Localizer["ContactMessages"]</h5>
                <p>@Localizer["ContactMessagesDesc"]</p>
                <span class="action-arrow"><i class="bi bi-arrow-right"></i></span>
            </a>
        </div>
    </div>

    <!-- Recent Activity -->
    <div class="dashboard-activity" data-aos="fade-up" data-aos-delay="300">
        <h2 class="section-title">@Localizer["RecentActivity"]</h2>
        <div class="activity-timeline" id="activityTimeline">
            <div class="activity-item">
                <div class="activity-time">@Localizer["JustNow"]</div>
                <div class="activity-content">
                    <div class="activity-dot"></div>
                    <div class="activity-text">
                        <strong>@Localizer["NewLoadRequest"]</strong>
                        <span>@Localizer["From"] client@example.com</span>
                    </div>
                </div>
            </div>
            <div class="activity-item">
                <div class="activity-time">10 min</div>
                <div class="activity-content">
                    <div class="activity-dot"></div>
                    <div class="activity-text">
                        <strong>@Localizer["OfferAccepted"]</strong>
                        <span>@Localizer["For"] @Localizer["CargoName"]</span>
                    </div>
                </div>
            </div>
            <div class="activity-item">
                <div class="activity-time">1 hour</div>
                <div class="activity-content">
                    <div class="activity-dot"></div>
                    <div class="activity-text">
                        <strong>@Localizer["UserRegistered"]</strong>
                        <span>@Localizer["NewUser"]</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Quote -->
    <div class="dashboard-quote" data-aos="fade-up" data-aos-delay="400">
        <div class="quote-line"></div>
        <p class="quote-text">“@Localizer["DashboardQuote"]”</p>
        <small class="quote-author">— @Localizer["DashboardQuoteAuthor"]</small>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        // Animate stats numbers
        function animateNumber(element, target, duration = 2000) {
            const start = 0;
            const startTime = performance.now();

            function update(currentTime) {
                const elapsed = currentTime - startTime;
                const progress = Math.min(elapsed / duration, 1);
                const current = Math.floor(progress * target);
                element.textContent = current.toLocaleString();

                if (progress < 1) {
                    requestAnimationFrame(update);
                } else {
                    element.textContent = target.toLocaleString();
                }
            }

            requestAnimationFrame(update);
        }

        // Set initial values and animate
        const loadRequestsEl = document.getElementById('loadRequestsCount');
        const usersEl = document.getElementById('usersCount');
        const trucksEl = document.getElementById('trucksCount');
        const messagesEl = document.getElementById('messagesCount');
        const pendingEl = document.getElementById('pendingCount');

        // Fetch real data from API endpoints
        fetch('/api/admin/stats')
            .then(response => response.json())
            .then(data => {
                animateNumber(loadRequestsEl, data.totalRequests || 0);
                animateNumber(usersEl, data.totalUsers || 0);
                animateNumber(trucksEl, data.activeTrucks || 0);
                animateNumber(messagesEl, data.newMessages || 0);
                if (pendingEl) {
                    pendingEl.textContent = data.pendingRequests || 0;
                }
            })
            .catch(() => {
                // Fallback with sample data
                animateNumber(loadRequestsEl, 42);
                animateNumber(usersEl, 156);
                animateNumber(trucksEl, 28);
                animateNumber(messagesEl, 7);
                if (pendingEl) {
                    pendingEl.textContent = '5';
                }
            });

        // Add hover glow effect on cards
        document.querySelectorAll('.action-card').forEach(card => {
            card.addEventListener('mouseenter', function(e) {
                const rect = this.getBoundingClientRect();
                const x = e.clientX - rect.left;
                const y = e.clientY - rect.top;
                this.style.setProperty('--mouse-x', x + 'px');
                this.style.setProperty('--mouse-y', y + 'px');
            });
        });

        // Add micro-interactions to stat cards
        document.querySelectorAll('.stat-card').forEach(card => {
            card.addEventListener('mouseenter', function() {
                this.style.transform = 'translateY(-8px)';
                this.style.boxShadow = '0 12px 48px rgba(212, 160, 23, 0.15)';
            });
            card.addEventListener('mouseleave', function() {
                this.style.transform = '';
                this.style.boxShadow = '';
            });
        });

        // Real-time clock update in activity section
        function updateActivityTimes() {
            const items = document.querySelectorAll('.activity-item .activity-time');
            const times = [
                { id: 0, label: '@Localizer["JustNow"]' },
                { id: 1, label: '10 min' },
                { id: 2, label: '1 hour' }
            ];
            // In a real app, you'd fetch actual timestamps
        }
        updateActivityTimes();
    });
</script>

<style>
    .admin-dashboard {
        padding: 20px 0;
    }

    .dashboard-hero {
        background: linear-gradient(135deg, var(--logistics-primary-dark), var(--logistics-primary));
        border-radius: 20px;
        padding: 40px 50px;
        text-align: center;
        border: 1px solid rgba(212, 160, 23, 0.1);
        margin-bottom: 30px;
        position: relative;
        overflow: hidden;
    }

    .dashboard-hero::after {
        content: '';
        position: absolute;
        top: -50%;
        right: -20%;
        width: 300px;
        height: 300px;
        background: radial-gradient(circle, rgba(212, 160, 23, 0.05), transparent 70%);
        border-radius: 50%;
    }

    .hero-icon-wrapper {
        width: 72px;
        height: 72px;
        background: rgba(212, 160, 23, 0.1);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 16px;
        font-size: 2rem;
        color: var(--logistics-accent);
        border: 1px solid rgba(212, 160, 23, 0.15);
    }

    .dashboard-hero-title {
        font-size: 2.2rem;
        font-weight: 700;
        color: white;
        margin-bottom: 12px;
    }

    .dashboard-hero-line {
        width: 60px;
        height: 2px;
        background: var(--logistics-accent);
        margin: 0 auto 16px;
    }

    .dashboard-hero-subtitle {
        color: rgba(255, 255, 255, 0.6);
        font-size: 1.05rem;
        max-width: 500px;
        margin: 0 auto;
    }

    /* Stats */
    .stats-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 20px;
        margin-bottom: 40px;
    }

    .stat-card {
        background: var(--logistics-primary-dark);
        border-radius: 16px;
        padding: 24px;
        border: 1px solid rgba(212, 160, 23, 0.08);
        transition: all 0.3s ease;
        position: relative;
        overflow: hidden;
    }

    .stat-card::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 3px;
        background: var(--logistics-accent);
        opacity: 0;
        transition: opacity 0.3s ease;
    }

    .stat-card:hover::before {
        opacity: 1;
    }

    .stat-icon {
        font-size: 1.5rem;
        color: var(--logistics-accent);
        margin-bottom: 8px;
        opacity: 0.6;
    }

    .stat-number {
        font-size: 2.2rem;
        font-weight: 700;
        color: white;
        line-height: 1.2;
    }

    .stat-label {
        color: rgba(255, 255, 255, 0.5);
        font-size: 0.85rem;
        margin-top: 4px;
    }

    .stat-trend {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        font-size: 0.75rem;
        font-weight: 600;
        padding: 2px 10px;
        border-radius: 20px;
        margin-top: 8px;
    }

    .stat-trend.up {
        background: rgba(40, 167, 69, 0.15);
        color: #28a745;
    }

    .stat-trend.down {
        background: rgba(220, 53, 69, 0.15);
        color: #dc3545;
    }

    /* Actions */
    .dashboard-actions {
        margin-bottom: 40px;
    }

    .section-title {
        font-size: 1.3rem;
        font-weight: 600;
        color: white;
        margin-bottom: 20px;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .section-title::after {
        content: '';
        flex: 1;
        height: 1px;
        background: rgba(212, 160, 23, 0.1);
    }

    .actions-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 16px;
    }

    .action-card {
        background: var(--logistics-primary-dark);
        border-radius: 16px;
        padding: 24px;
        border: 1px solid rgba(212, 160, 23, 0.06);
        text-decoration: none;
        color: inherit;
        transition: all 0.3s ease;
        position: relative;
        overflow: hidden;
        display: block;
    }

    .action-card:hover {
        transform: translateY(-4px);
        border-color: rgba(212, 160, 23, 0.2);
        box-shadow: 0 8px 32px rgba(0, 0, 0, 0.2);
    }

    .action-card.highlight {
        border-color: rgba(212, 160, 23, 0.2);
        background: rgba(212, 160, 23, 0.03);
    }

    .action-icon {
        font-size: 1.8rem;
        color: var(--logistics-accent);
        opacity: 0.7;
        margin-bottom: 12px;
    }

    .action-card h5 {
        color: white;
        font-size: 1rem;
        font-weight: 600;
        margin-bottom: 4px;
    }

    .action-card p {
        color: rgba(255, 255, 255, 0.4);
        font-size: 0.85rem;
        margin: 0;
    }

    .action-arrow {
        position: absolute;
        bottom: 16px;
        right: 20px;
        color: var(--logistics-accent);
        opacity: 0.3;
        font-size: 1.2rem;
        transition: all 0.3s ease;
    }

    .action-card:hover .action-arrow {
        opacity: 1;
        transform: translateX(4px);
    }

    .action-badge {
        position: absolute;
        top: 12px;
        right: 16px;
        background: #e63946;
        color: white;
        font-size: 0.7rem;
        font-weight: 700;
        padding: 2px 10px;
        border-radius: 20px;
        min-width: 24px;
        text-align: center;
    }

    /* Activity Timeline */
    .activity-timeline {
        background: var(--logistics-primary-dark);
        border-radius: 16px;
        padding: 20px 24px;
        border: 1px solid rgba(212, 160, 23, 0.06);
    }

    .activity-item {
        display: flex;
        gap: 16px;
        padding: 10px 0;
        border-bottom: 1px solid rgba(255, 255, 255, 0.03);
    }

    .activity-item:last-child {
        border-bottom: none;
    }

    .activity-time {
        color: rgba(255, 255, 255, 0.3);
        font-size: 0.8rem;
        min-width: 60px;
        padding-top: 2px;
    }

    .activity-content {
        display: flex;
        align-items: center;
        gap: 12px;
        flex: 1;
    }

    .activity-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: var(--logistics-accent);
        flex-shrink: 0;
        opacity: 0.6;
    }

    .activity-text {
        color: rgba(255, 255, 255, 0.7);
        font-size: 0.9rem;
    }

    .activity-text strong {
        color: white;
        font-weight: 600;
    }

    .activity-text span {
        color: rgba(255, 255, 255, 0.4);
        font-size: 0.85rem;
    }

    /* Quote */
    .dashboard-quote {
        text-align: center;
        padding: 24px 0 8px;
    }

    .quote-line {
        width: 40px;
        height: 2px;
        background: rgba(212, 160, 23, 0.2);
        margin: 0 auto 16px;
    }

    .quote-text {
        color: rgba(255, 255, 255, 0.5);
        font-style: italic;
        font-size: 1.05rem;
        margin: 0;
    }

    .quote-author {
        color: rgba(255, 255, 255, 0.25);
        font-size: 0.85rem;
        margin-top: 8px;
        display: block;
    }

    @@media (max-width: 768px) {
        .dashboard-hero {
            padding: 30px 20px;
        }

        .dashboard-hero-title {
            font-size: 1.6rem;
        }

        .stats-grid {
            grid-template-columns: repeat(2, 1fr);
        }

        .actions-grid {
            grid-template-columns: repeat(2, 1fr);
        }

        .activity-item {
            flex-direction: column;
            gap: 4px;
        }

        .activity-time {
            min-width: auto;
            font-size: 0.7rem;
        }
    }
</style>