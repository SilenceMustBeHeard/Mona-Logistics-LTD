@using Mona_Logistics_LTD.Data.Common.Enums
@using Mona_Logistics_LTD.Services.Localizer.Interfaces
@using Mona_Logistics_LTD.Web.ViewModels.Admin.Interactions
@using Microsoft.AspNetCore.Identity
@model IEnumerable<UserManagmentIndexViewModel>
@inject IJsonLocalizer Localizer
@inject RoleManager<IdentityRole> RoleManager

@{
    ViewData["Title"] = Localizer["UserManagementTitle"];
    var totalUsers = Model.Count();
    var adminCount = Model.Count(u => u.Roles.Contains("Admin"));
    var managerCount = Model.Count(u => u.Roles.Contains("Manager"));
    var userCount = Model.Count(u => u.Roles.Contains("User") && !u.Roles.Contains("Admin") && !u.Roles.Contains("Manager"));
}

<div class="container py-5">
    <div class="logistics-card p-4">

        <!-- Header -->
        <div class="text-center mb-4">
            <div class="user-management-header">
                <i class="bi bi-people-fill display-4" style="color: var(--logistics-accent);"></i>
                <h1 class="display-5 mt-2 fw-bold" style="color: white;">@Localizer["UserManagementTitle"]</h1>
                <div class="accent-line mx-auto"></div>
                <p style="color: rgba(255,255,255,0.5);">@Localizer["UserManagementSubtitle"]</p>

                <!-- Stats -->
                <div class="user-stats mt-3 d-flex gap-3 justify-content-center flex-wrap">
                    <div class="stat-badge" style="background: rgba(212,160,23,0.1); padding: 6px 18px; border-radius: 30px; border: 1px solid rgba(212,160,23,0.1);">
                        <i class="bi bi-people-fill me-1" style="color: var(--logistics-accent);"></i>
                        <span style="color: rgba(255,255,255,0.4);">@Localizer["TotalUsers"]:</span>
                        <strong style="color: white;">@totalUsers</strong>
                    </div>
                    <div class="stat-badge" style="background: rgba(212,160,23,0.08); padding: 6px 18px; border-radius: 30px; border: 1px solid rgba(212,160,23,0.05);">
                        <i class="bi bi-shield-lock-fill me-1" style="color: var(--logistics-accent);"></i>
                        <span style="color: rgba(255,255,255,0.4);">@Localizer["Admins"]:</span>
                        <strong style="color: var(--logistics-accent);">@adminCount</strong>
                    </div>
                    <div class="stat-badge" style="background: rgba(13,202,240,0.08); padding: 6px 18px; border-radius: 30px; border: 1px solid rgba(13,202,240,0.05);">
                        <i class="bi bi-person-badge-fill me-1" style="color: #0dcaf0;"></i>
                        <span style="color: rgba(255,255,255,0.4);">@Localizer["Managers"]:</span>
                        <strong style="color: #0dcaf0;">@managerCount</strong>
                    </div>
                    <div class="stat-badge" style="background: rgba(40,167,69,0.08); padding: 6px 18px; border-radius: 30px; border: 1px solid rgba(40,167,69,0.05);">
                        <i class="bi bi-person-fill me-1" style="color: #28a745;"></i>
                        <span style="color: rgba(255,255,255,0.4);">@Localizer["Users"]:</span>
                        <strong style="color: #28a745;">@userCount</strong>
                    </div>
                </div>
            </div>
        </div>

        <!-- Back Button -->
        <div class="mb-4 d-flex justify-content-between align-items-center flex-wrap gap-3">
            <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index" class="btn-logistics-outline" style="padding: 8px 20px;">
                <i class="bi bi-arrow-left me-1"></i> @Localizer["BackToDashboard"]
            </a>
            <button id="refreshUsersBtn" class="btn-logistics-outline" style="padding: 8px 20px;">
                <i class="bi bi-arrow-repeat me-1"></i> @Localizer["Refresh"]
            </button>
        </div>

        @if (!Model.Any())
        {
            <div class="text-center py-5">
                <i class="bi bi-people display-4" style="color: rgba(255,255,255,0.1);"></i>
                <p class="mt-3" style="color: rgba(255,255,255,0.5);">@Localizer["NoUsersFound"]</p>
            </div>
        }
        else
        {
            <div class="row g-4" id="usersGrid">
                @foreach (var user in Model)
                {
                    var isBanned = user.IsBanned;
                    var isAdmin = user.Roles.Contains("Admin");
                    var isManager = user.Roles.Contains("Manager");
                    var isUser = !isAdmin && !isManager;

                    <div class="col-lg-4 col-md-6">
                        <div class="user-card @(isBanned ? "banned" : "") @(isAdmin ? "admin-card" : "")">

                            <!-- Banned Badge -->
                            @if (isBanned)
                            {
                                <div class="banned-ribbon">
                                    <i class="bi bi-ban me-1"></i> @Localizer["Banned"]
                                </div>
                            }

                            <!-- Admin Crown -->
                            @if (isAdmin)
                            {
                                <div class="admin-crown">
                                    <i class="bi bi-shield-lock-fill me-1"></i>
                                    @Localizer["Administrator"]
                                </div>
                            }

                            <div class="user-card-body @(isBanned ? "pt-5" : "pt-3")">
                                <!-- Avatar -->
                                <div class="text-center mb-3">
                                    <div class="user-avatar @(isBanned ? "banned-avatar" : "")">
                                        <i class="bi @(isAdmin ? "bi-shield-lock-fill" : isManager ? "bi-person-badge-fill" : "bi-person-fill")"></i>
                                    </div>
                                    <div class="user-status @(isBanned ? "status-banned" : "status-active")">
                                        <i class="bi @(isBanned ? "bi-ban" : "bi-check-circle-fill")"></i>
                                    </div>
                                    <h5 class="user-email">@user.Email</h5>
                                </div>

                                <!-- Roles -->
                                <div class="user-roles">
                                    @foreach (var role in user.Roles)
                                    {
                                        <span class="role-badge @(role == "Admin" ? "role-admin" : role == "Manager" ? "role-manager" : "role-user")">
                                            <i class="bi @(role == "Admin" ? "bi-shield-lock-fill" : role == "Manager" ? "bi-person-badge-fill" : "bi-person-fill") me-1"></i>
                                            @role
                                        </span>
                                    }
                                </div>

                                @if (!isAdmin)
                                {
                                    <!-- Role Selector -->
                                    <div class="role-selector">
                                        <label class="form-label small" style="color: rgba(255,255,255,0.4);">
                                            <i class="bi bi-tag me-1"></i> @Localizer["AssignRole"]
                                        </label>
                                        <select class="form-select logistics-input role-select" id="roleSelect-@user.Id" @(isBanned ? "disabled" : "")>
                                            <option value="">-- @Localizer["SelectRole"] --</option>
                                            @foreach (var role in RoleManager.Roles)
                                            {
                                                <option value="@role.Name">@role.Name</option>
                                            }
                                        </select>
                                    </div>

                                    <!-- Actions -->
                                    <div class="user-actions">
                                        @if (!isBanned)
                                        {
                                            <form method="post" asp-action="AssignRole" class="action-form" onsubmit="return prepareAssignRole('@user.Id')">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="UserId" value="@user.Id" />
                                                <input type="hidden" name="NewRole" id="newRoleInput-@user.Id" />
                                                <button type="submit" class="btn-logistics-primary w-100" style="padding: 6px 12px; font-size: 0.85rem;">
                                                    <i class="bi bi-person-plus-fill me-1"></i> @Localizer["Assign"]
                                                </button>
                                            </form>

                                            <form method="post" asp-action="DisableUser" class="action-form" onsubmit="return confirmAction('@user.Id', 'ban')">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="userId" value="@user.Id" />
                                                <button type="submit" class="btn-logistics-outline w-100" style="padding: 6px 12px; font-size: 0.85rem; border-color: #dc3545; color: #dc3545;">
                                                    <i class="bi bi-ban me-1"></i> @Localizer["Ban"]
                                                </button>
                                            </form>
                                        }
                                        else
                                        {
                                            <div class="text-center" style="color: rgba(255,255,255,0.3); padding: 8px 0;">
                                                <i class="bi bi-lock-fill me-1"></i> @Localizer["UserBanned"]
                                            </div>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <div class="admin-protected">
                                        <i class="bi bi-shield-lock-fill me-1"></i>
                                        <small>@Localizer["AdminProtected"]</small>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>

<script>
    function prepareAssignRole(userId) {
        const select = document.getElementById(`roleSelect-${userId}`);
        const selectedRole = select?.value;

        if (!selectedRole) {
            showToast('@Localizer["SelectRoleFirst"]', 'error');
            select?.focus();
            select?.classList.add('border-danger');
            setTimeout(() => select?.classList.remove('border-danger'), 2000);
            return false;
        }

        document.getElementById(`newRoleInput-${userId}`).value = selectedRole;
        return true;
    }

    function confirmAction(userId, action) {
        const isBan = action === 'ban';
        const message = isBan ? '@Localizer["BanConfirm"]' : '@Localizer["UnbanConfirm"]';
        return confirm(message);
    }

    function showToast(message, type = 'info') {
        const existing = document.querySelector('.user-toast');
        if (existing) existing.remove();

        const toast = document.createElement('div');
        toast.className = `user-toast ${type}`;
        toast.style.cssText = `
            position: fixed; bottom: 20px; right: 20px; z-index: 9999;
            padding: 12px 20px; border-radius: 10px;
            background: var(--logistics-primary-dark);
            border-left: 4px solid ${type === 'success' ? '#28a745' : type === 'error' ? '#dc3545' : 'var(--logistics-accent)'};
            color: white; box-shadow: 0 8px 24px rgba(0,0,0,0.3);
            transform: translateX(120%); transition: transform 0.3s ease;
        `;
        toast.innerHTML = `<i class="bi ${type === 'success' ? 'bi-check-circle-fill' : type === 'error' ? 'bi-exclamation-triangle-fill' : 'bi-info-circle-fill'} me-2"></i> ${message}`;
        document.body.appendChild(toast);
        setTimeout(() => toast.style.transform = 'translateX(0)', 100);
        setTimeout(() => { toast.style.transform = 'translateX(120%)'; setTimeout(() => toast.remove(), 300); }, 4000);
    }

    document.getElementById('refreshUsersBtn')?.addEventListener('click', function() {
        this.innerHTML = '<i class="bi bi-arrow-repeat spinner me-1"></i> @Localizer["Refreshing"]...';
        this.disabled = true;
        setTimeout(() => location.reload(), 500);
    });

   
    document.querySelectorAll('.user-card').forEach((card, i) => {
        card.style.opacity = '0';
        card.style.transform = 'translateY(20px)';
        card.style.transition = 'all 0.5s ease';
        setTimeout(() => {
            card.style.opacity = '1';
            card.style.transform = 'translateY(0)';
        }, 100 + i * 80);
    });
</script>

