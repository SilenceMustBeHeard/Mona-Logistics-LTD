@using Mona_Logistics_LTD.Data.Common.Enums
@using Mona_Logistics_LTD.Services.Localizer.Interfaces
@using Mona_Logistics_LTD.Web.ViewModels.User.Account.Messages
@inject IJsonLocalizer Localizer

@model IEnumerable<SystemMessageViewModel>

@{
    ViewData["Title"] = Localizer["SystemMessagesTitle"];
}

<div class="container py-5">
    <div class="logistics-card p-4">
        <div class="text-center mb-4">
            <i class="bi bi-megaphone-fill display-4" style="color: var(--logistics-accent);"></i>
            <h1 class="h2 mt-2" style="color: white;">@Localizer["SystemMessagesTitle"]</h1>
            <div class="accent-line mx-auto"></div>
            <p style="color: rgba(255,255,255,0.5);">@Localizer["SystemMessagesSubtitle"]</p>
            <div class="d-flex gap-3 justify-content-center flex-wrap mt-3">
                <span class="badge" style="background: rgba(212,160,23,0.15); color: var(--logistics-accent); padding: 8px 16px;">
                    <i class="bi bi-envelope-paper me-1"></i> @Localizer["TotalSent"]: <strong>@Model.Count()</strong>
                </span>
                <span class="badge" style="background: rgba(230,57,70,0.15); color: #e63946; padding: 8px 16px;">
                    <i class="bi bi-envelope-open-fill me-1"></i> @Localizer["Unread"]: <strong>@Model.Count(m => !m.IsRead)</strong>
                </span>
            </div>
        </div>

        <div class="mb-4 d-flex justify-content-between align-items-center flex-wrap gap-3">
            <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index" class="btn-logistics-outline" style="padding: 8px 20px;">
                <i class="bi bi-arrow-left me-1"></i> @Localizer["BackToDashboard"]
            </a>
            <a asp-area="Admin" asp-controller="SystemMessage" asp-action="Create" class="btn-logistics-primary" style="padding: 8px 20px;">
                <i class="bi bi-plus-circle me-1"></i> @Localizer["NewMessage"]
            </a>
        </div>

        @if (!Model.Any())
        {
            <div class="text-center py-5">
                <i class="bi bi-envelope-paper display-1" style="color: rgba(255,255,255,0.1);"></i>
                <p class="mt-3" style="color: rgba(255,255,255,0.5);">@Localizer["NoSystemMessages"]</p>
                <p class="small" style="color: rgba(255,255,255,0.3);">@Localizer["SendFirstMessage"]</p>
                <a asp-area="Admin" asp-controller="SystemMessage" asp-action="Create" class="btn-logistics-primary mt-3">
                    <i class="bi bi-plus-circle me-2"></i> @Localizer["SendFirstMessage"]
                </a>
            </div>
        }
        else
        {
            <div class="row g-4">
                @foreach (var message in Model.OrderByDescending(m => m.CreatedOn))
                {
                    <div class="col-md-6 col-lg-4">
                        <div class="logistics-card p-3 h-100 @(!message.IsRead ? "unread-message" : "")" style="border-color: @(!message.IsRead ? "rgba(212,160,23,0.2)" : "rgba(255,255,255,0.04)");">
                            <div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-2">
                                <div class="d-flex gap-2">
                                    @if (!message.IsRead)
                                    {
                                        <span class="badge" style="background: #e63946; color: white;">@Localizer["New"]</span>
                                    }
                                    <span class="badge" style="background: rgba(212,160,23,0.15); color: var(--logistics-accent);">
                                        @(message.Type switch
                                        {
                                            InboxMessageType.AdminToUser => "📢",
                                            InboxMessageType.Notification => "🔔",
                                            InboxMessageType.System => "⚙️",
                                            _ => "💬"
                                        })
                                    </span>
                                </div>
                                <small style="color: rgba(255,255,255,0.3);">
                                    <i class="bi bi-calendar-heart me-1"></i>
                                    @message.CreatedOn.ToLocalTime().ToString("dd MMM yyyy")
                                </small>
                            </div>
                            <p class="small" style="color: rgba(255,255,255,0.5);">
                                @(message.Description.Length > 100 ? message.Description.Substring(0, 100) + "..." : message.Description)
                            </p>
                            <a asp-area="Admin" asp-controller="SystemMessage" asp-action="Details" asp-route-id="@message.Id" class="btn-logistics-outline w-100" style="padding: 6px 12px; font-size: 0.85rem;">
                                <i class="bi bi-eye me-1"></i> @Localizer["ReadMessage"]
                            </a>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>