@using Mona_Logistics_LTD.Services.Localizer.Interfaces
@using Mona_Logistics_LTD.Web.ViewModels.Admin.Messages
@inject IJsonLocalizer Localizer

@model ContactMessageDetailsViewModel

@{
    ViewData["Title"] = Localizer["ContactMessageDetailsTitle"];
    bool hasResponse = !string.IsNullOrEmpty(Model.Response);
}

<div class="container py-5">
    <div class="logistics-card p-4">
        <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
            <div class="d-flex align-items-center gap-3">
                <i class="bi bi-envelope-paper display-6" style="color: var(--logistics-accent);"></i>
                <div>
                    <h2 class="fw-bold mb-0" style="color: white;">@Localizer["ContactMessageDetailsTitle"]</h2>
                    <p class="small" style="color: rgba(255,255,255,0.4);">@Localizer["FromClient"]</p>
                </div>
            </div>
            <a asp-area="Admin" asp-controller="AdminInbox" asp-action="Index" class="btn-logistics-outline" style="padding: 8px 20px;">
                <i class="bi bi-arrow-left me-1"></i> @Localizer["BackToInbox"]
            </a>
        </div>

        <div class="d-flex justify-content-between align-items-start mb-4 flex-wrap gap-3">
            <div>
                <h3 class="fw-bold" style="color: white;">@Model.Subject</h3>
                <div class="d-flex align-items-center gap-2 mt-2 flex-wrap">
                    @if (!Model.IsReadByAdmin && !hasResponse)
                    {
                        <span class="badge" style="background: #e63946; color: white;">@Localizer["New"]</span>
                    }
                    @if (hasResponse)
                    {
                        <span class="badge" style="background: rgba(40,167,69,0.15); color: #28a745;">@Localizer["Replied"]</span>
                    }
                </div>
            </div>
            <div style="color: rgba(255,255,255,0.3);">
                <i class="bi bi-clock me-1"></i>
                <span>@Model.CreatedOn.ToLocalTime().ToString("dd MMM yyyy · HH:mm")</span>
            </div>
        </div>

        <hr style="border-color: rgba(212,160,23,0.1);">

        <!-- Sender Information -->
        <div class="mb-4">
            <h6 class="text-accent mb-3"><i class="bi bi-person-circle me-1"></i> @Localizer["SenderInfo"]</h6>
            <div class="p-3 rounded-3" style="background: rgba(255,255,255,0.02); border: 1px solid rgba(255,255,255,0.04);">
                <div class="row">
                    <div class="col-md-6">
                        <span style="color: rgba(255,255,255,0.4);">@Localizer["Name"]</span>
                        <p style="color: rgba(255,255,255,0.8);"><i class="bi bi-person me-2 text-accent"></i> @Model.SenderName</p>
                    </div>
                    <div class="col-md-6">
                        <span style="color: rgba(255,255,255,0.4);">@Localizer["Email"]</span>
                        <p style="color: rgba(255,255,255,0.8);">
                            <i class="bi bi-envelope me-2 text-accent"></i>
                            <a href="mailto:@Model.SenderEmail" style="color: var(--logistics-accent); text-decoration: none;">@Model.SenderEmail</a>
                        </p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Message Content -->
        <div class="mb-4">
            <h6 class="text-accent mb-3"><i class="bi bi-chat-text me-1"></i> @Localizer["Message"]</h6>
            <div class="p-3 rounded-3" style="background: rgba(255,255,255,0.02); border: 1px solid rgba(255,255,255,0.04);">
                <p style="white-space: pre-wrap; color: rgba(255,255,255,0.8);">@Model.Message</p>
            </div>
        </div>

        <!-- Response Section -->
        @if (hasResponse)
        {
            <div class="mb-4">
                <h6 class="text-accent mb-3"><i class="bi bi-reply-all-fill me-1"></i> @Localizer["YourResponse"]</h6>
                <div class="p-3 rounded-3" style="background: rgba(212,160,23,0.05); border: 1px solid rgba(212,160,23,0.1);">
                    <p style="white-space: pre-wrap; color: rgba(255,255,255,0.8);">@Model.Response</p>
                    <div style="color: rgba(255,255,255,0.3); font-size: 0.85rem; margin-top: 8px;">
                        <i class="bi bi-reply-all me-1"></i> @Localizer["RespondedOn"] @Model.RespondedOnFormatted
                        @if (!string.IsNullOrEmpty(Model.RespondedByName))
                        {
                            <span class="ms-2"><i class="bi bi-person me-1"></i> @Localizer["By"] @Model.RespondedByName</span>
                        }
                    </div>
                </div>
            </div>
        }

        <hr style="border-color: rgba(212,160,23,0.1);">

        <div class="d-flex gap-2 justify-content-end mt-4 flex-wrap">
            @if (!hasResponse)
            {
                <a asp-area="Admin" asp-controller="ContactMessage" asp-action="Respond" asp-route-id="@Model.Id" class="btn-logistics-primary" id="respondBtn">
                    <i class="bi bi-send me-2"></i> @Localizer["RespondToMessage"]
                </a>
            }
            <a asp-area="Admin" asp-controller="AdminInbox" asp-action="Index" class="btn-logistics-outline">
                <i class="bi bi-check2-circle me-2"></i> @Localizer["Done"]
            </a>
        </div>
    </div>
</div>

<script>
    document.getElementById('respondBtn')?.addEventListener('click', function(e) {
        if (this.dataset.clicked) { e.preventDefault(); return; }
        this.dataset.clicked = 'true';
        this.innerHTML = '<i class="bi bi-hourglass-split me-2"></i> @Localizer["Loading"]...';
        setTimeout(() => { this.dataset.clicked = ''; }, 2000);
    });
</script>