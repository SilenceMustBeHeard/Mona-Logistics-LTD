@using Mona_Logistics_LTD.Data.Common.Enums
@using Mona_Logistics_LTD.Services.Localizer.Interfaces
@using Mona_Logistics_LTD.Web.ViewModels.Admin.LoadRequest
@model LoadRequestAdminDetailsViewModel

@inject IJsonLocalizer Localizer

@{
    ViewData["Title"] = Localizer["RequestDetailsTitle"];
}

<div class="container py-5">
    <div class="d-flex gap-3 mb-4 flex-wrap">
        <a asp-action="Index" class="btn-logistics-outline" style="padding: 8px 20px;">
            <i class="bi bi-arrow-left me-1"></i> @Localizer["BackToList"]
        </a>
        @if (Model.CanCreateOffer && !Model.HasPendingOffer)
        {
            <a asp-action="CreateOffer" asp-route-id="@Model.Id" class="btn-logistics-primary" style="padding: 8px 20px;">
                <i class="bi bi-plus-circle me-1"></i> @Localizer["CreateOffer"]
            </a>
        }
        @if (Model.HasPendingOffer)
        {
            <span class="btn-logistics-outline" style="padding: 8px 20px; border-color: #28a745; color: #28a745; cursor: default;">
                <i class="bi bi-clock me-1"></i> @Localizer["OfferPending"]
            </span>
        }
    </div>

    <div class="row g-4">
        <!-- Request Details -->
        <div class="col-lg-7">
            <div class="logistics-card p-4">
                <div class="d-flex justify-content-between align-items-start mb-4">
                    <div>
                        <h1 style="color: white; font-size: 1.8rem;">@Model.CargoName</h1>
                        <p style="color: rgba(255,255,255,0.5);">
                            <i class="bi bi-calendar3 me-1"></i>
                            @Localizer["CreatedOn"]: @Model.CreatedAt.ToLocalTime().ToString("dd MMM yyyy HH:mm")
                        </p>
                    </div>
                    <span class="status-badge @(Model.Status switch
                    {
                        LoadRequestStatus.Pending => "status-pending",
                        LoadRequestStatus.UnderReview => "status-underreview",
                        LoadRequestStatus.Offered => "status-offered",
                        LoadRequestStatus.Accepted => "status-accepted",
                        LoadRequestStatus.InProgress => "status-inprogress",
                        LoadRequestStatus.Completed => "status-completed",
                        LoadRequestStatus.Cancelled => "status-cancelled",
                        _ => ""
                    })" style="font-size: 0.9rem; padding: 6px 16px;">
                        @(Model.Status switch
                        {
                            LoadRequestStatus.Pending => Localizer["Pending"],
                            LoadRequestStatus.UnderReview => Localizer["UnderReview"],
                            LoadRequestStatus.Offered => Localizer["Offered"],
                            LoadRequestStatus.Accepted => Localizer["Accepted"],
                            LoadRequestStatus.InProgress => Localizer["InProgress"],
                            LoadRequestStatus.Completed => Localizer["Completed"],
                            LoadRequestStatus.Cancelled => Localizer["Cancelled"],
                            _ => Model.Status.ToString()
                        })
                    </span>
                </div>

                <div class="row g-3">
                    <div class="col-md-6">
                        <h6 class="text-accent">@Localizer["CargoInfoTitle"]</h6>
                        <div class="detail-item"><span class="detail-label">@Localizer["CargoName"]</span><span class="detail-value">@Model.CargoName</span></div>
                        <div class="detail-item"><span class="detail-label">@Localizer["CargoDescription"]</span><span class="detail-value">@Model.CargoDescription</span></div>
                        <div class="detail-item"><span class="detail-label">@Localizer["WeightKg"]</span><span class="detail-value">@Model.WeightKg kg</span></div>
                        <div class="detail-item"><span class="detail-label">@Localizer["LinearMeters"]</span><span class="detail-value">@Model.LinearMeters.ToString("F2") lm</span></div>
                        <div class="detail-item"><span class="detail-label">@Localizer["IsFragile"]</span><span class="detail-value">@(Model.IsFragile ? "✅ Yes" : "❌ No")</span></div>
                        <div class="detail-item"><span class="detail-label">@Localizer["RequiresCooling"]</span><span class="detail-value">@(Model.RequiresCooling ? "✅ Yes" : "❌ No")</span></div>
                    </div>
                    <div class="col-md-6">
                        <h6 class="text-accent">@Localizer["TransportDetailsTitle"]</h6>
                        <div class="detail-item"><span class="detail-label">@Localizer["PickupAddress"]</span><span class="detail-value">@Model.PickupAddress</span></div>
                        <div class="detail-item"><span class="detail-label">@Localizer["DeliveryAddress"]</span><span class="detail-value">@Model.DeliveryAddress</span></div>
                        <div class="detail-item"><span class="detail-label">@Localizer["PreferredPickupDate"]</span><span class="detail-value">@Model.PreferredPickupDate.ToString("dd MMM yyyy HH:mm")</span></div>
                        <div class="detail-item"><span class="detail-label">@Localizer["PreferredDeliveryDate"]</span><span class="detail-value">@(Model.PreferredDeliveryDate?.ToString("dd MMM yyyy HH:mm") ?? Localizer["NotSpecified"])</span></div>
                        <div class="detail-item"><span class="detail-label">@Localizer["PreferredVehicleType"]</span><span class="detail-value">@Model.PreferredVehicleType</span></div>
                        @if (!string.IsNullOrEmpty(Model.Notes))
                        {
                            <div class="detail-item"><span class="detail-label">@Localizer["Notes"]</span><span class="detail-value">@Model.Notes</span></div>
                        }
                    </div>
                </div>

                <!-- Client Info -->
                <hr style="border-color: rgba(212,160,23,0.15); margin: 1.5rem 0;" />
                <h6 class="text-accent">@Localizer["ClientInfo"]</h6>
                <div class="row g-2">
                    <div class="col-md-4"><span class="detail-label">@Localizer["Name"]</span><span class="detail-value">@Model.ClientName</span></div>
                    <div class="col-md-4"><span class="detail-label">@Localizer["Email"]</span><span class="detail-value">@Model.ClientEmail</span></div>
                    @if (!string.IsNullOrEmpty(Model.ClientPhone))
                    {
                        <div class="col-md-4"><span class="detail-label">@Localizer["Phone"]</span><span class="detail-value">@Model.ClientPhone</span></div>
                    }
                </div>
            </div>
        </div>

        <!-- Offers Section -->
        <div class="col-lg-5">
            <div class="logistics-card p-4">
                <h6 class="text-accent mb-3">
                    <i class="bi bi-file-earmark-text me-2"></i> @Localizer["Offers"]
                    <span class="badge" style="background: rgba(212,160,23,0.15); color: var(--logistics-accent); margin-left: 8px;">@Model.Offers.Count</span>
                </h6>

                @if (!Model.Offers.Any())
                {
                    <div class="text-center py-4">
                        <i class="bi bi-file-earmark-text display-4" style="color: rgba(255,255,255,0.1);"></i>
                        <p style="color: rgba(255,255,255,0.4);">@Localizer["NoOffersYet"]</p>
                    </div>
                }
                else
                {
                    @foreach (var offer in Model.Offers)
                    {
                        <div class="offer-item p-3 mb-3 rounded-3" style="background: rgba(255,255,255,0.02); border: 1px solid rgba(255,255,255,0.04);">
                            <div class="d-flex justify-content-between align-items-start">
                                <div>
                                    <div style="font-size: 1.2rem; font-weight: 700; color: var(--logistics-accent);">
                                        @offer.FinalPrice.ToString("F2") BGN
                                    </div>
                                    @if (offer.Discount.HasValue && offer.Discount > 0)
                                    {
                                        <div style="font-size: 0.8rem; color: rgba(255,255,255,0.3); text-decoration: line-through;">
                                            @offer.Price.ToString("F2") BGN
                                        </div>
                                    }
                                </div>
                                <span class="status-badge @(offer.IsExpired ? "status-expired" : offer.Status.ToString().ToLower())" style="font-size: 0.7rem; padding: 2px 10px;">
                                    @offer.StatusDisplay
                                </span>
                            </div>
                            <div style="font-size: 0.85rem; color: rgba(255,255,255,0.5); margin-top: 4px;">
                                <i class="bi bi-person me-1"></i> @offer.CreatedByName
                                <span style="margin: 0 6px;">|</span>
                                <i class="bi bi-calendar3 me-1"></i> @offer.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")
                            </div>
                            @if (!string.IsNullOrEmpty(offer.Notes))
                            {
                                <div style="font-size: 0.85rem; color: rgba(255,255,255,0.4); margin-top: 4px;">
                                    <i class="bi bi-chat me-1"></i> @offer.Notes
                                </div>
                            }
                            @if (offer.Status == OfferStatus.Pending && !offer.IsExpired)
                            {
                                <div class="d-flex gap-2 mt-2">
                                    <form asp-action="AcceptOffer" method="post" style="display:inline;">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@offer.Id" />
                                        <input type="hidden" name="requestId" value="@Model.Id" />
                                        <button type="submit" class="btn-sm" style="background: #28a745; color: white; border: none; padding: 4px 14px; border-radius: 6px;">
                                            <i class="bi bi-check-circle me-1"></i> @Localizer["Accept"]
                                        </button>
                                    </form>
                                    <form asp-action="RejectOffer" method="post" style="display:inline;">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@offer.Id" />
                                        <input type="hidden" name="requestId" value="@Model.Id" />
                                        <button type="submit" class="btn-sm" style="background: #dc3545; color: white; border: none; padding: 4px 14px; border-radius: 6px;">
                                            <i class="bi bi-x-circle me-1"></i> @Localizer["Reject"]
                                        </button>
                                    </form>
                                </div>
                            }
                        </div>
                    }
                }
            </div>
        </div>
    </div>
</div>