@using Mona_Logistics_LTD.Data.Common.Enums
@using Mona_Logistics_LTD.Web.ViewModels.Admin.LoadRequest
@using Mona_Logistics_LTD.Services.Localizer.Interfaces
@model IEnumerable<LoadRequestAdminListViewModel>

@inject IJsonLocalizer Localizer

@{
    ViewData["Title"] = Localizer["AdminLoadRequestsTitle"];
    var newCount = ViewBag.NewCount as int? ?? 0;
}

<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap">
        <div>
            <h1 style="color: white;">@Localizer["AdminLoadRequestsTitle"]</h1>
            <p style="color: rgba(255,255,255,0.6);">@Localizer["AdminLoadRequestsSubtitle"]</p>
        </div>
        <div class="d-flex align-items-center gap-3">
            @if (newCount > 0)
            {
                <span class="badge-new-requests" style="background: var(--logistics-accent); color: var(--logistics-primary-dark); padding: 6px 16px; border-radius: 30px; font-weight: 600; font-size: 0.9rem;">
                    <i class="bi bi-bell-fill me-1"></i> @Localizer["NewRequests"]: @newCount
                </span>
            }
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="text-center py-5 logistics-card">
            <i class="bi bi-inbox display-4" style="color: rgba(255,255,255,0.2);"></i>
            <p class="mt-3" style="color: rgba(255,255,255,0.6);">@Localizer["NoLoadRequests"]</p>
        </div>
    }
    else
    {
        <div class="table-container">
            <table class="table">
                <thead>
                    <tr>
                        <th>@Localizer["CargoName"]</th>
                        <th>@Localizer["Client"]</th>
                        <th>@Localizer["PickupAddress"]</th>
                        <th>@Localizer["DeliveryAddress"]</th>
                        <th>@Localizer["LinearMeters"]</th>
                        <th>@Localizer["Status"]</th>
                        <th>@Localizer["Actions"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var request in Model)
                    {
                        <tr>
                            <td>
                                <strong style="color: white;">@request.CargoName</strong>
                                @if (request.IsNew && request.Status != LoadRequestStatus.Cancelled)
                                {
                                    <span class="badge-new" style="background: #e63946; color: white; font-size: 0.6rem; padding: 2px 8px; border-radius: 20px; margin-left: 6px;">@Localizer["New"]</span>
                                }
                            </td>
                            <td>
                                <div>@request.ClientName</div>
                                <small style="color: rgba(255,255,255,0.4);">@request.ClientEmail</small>
                            </td>
                            <td>@request.PickupAddress</td>
                            <td>@request.DeliveryAddress</td>
                            <td>@request.LinearMeters.ToString("F2") lm</td>
                            <td>
                                <span class="status-badge @request.StatusCssClass">
                                    @request.StatusDisplay
                                </span>
                                @if (request.HasActiveOffer)
                                {
                                    <span class="badge-offer" style="background: rgba(40, 167, 69, 0.15); color: #28a745; font-size: 0.6rem; padding: 2px 8px; border-radius: 20px; margin-left: 6px;">
                                        <i class="bi bi-file-earmark-text"></i> Offer
                                    </span>
                                }
                            </td>
                            <td>
                                <a asp-action="Details" asp-route-id="@request.Id" class="btn-sm btn-logistics-primary">
                                    <i class="bi bi-eye"></i> @Localizer["View"]
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<script>
    // Auto-refresh new requests count every 60 seconds
    setInterval(function() {
        fetch('@Url.Action("GetNewCount")')
            .then(response => response.json())
            .then(data => {
                const badge = document.querySelector('.badge-new-requests');
                if (badge && data.count > 0) {
                    badge.innerHTML = `<i class="bi bi-bell-fill me-1"></i> @Localizer["NewRequests"]: ${data.count}`;
                    badge.style.display = 'inline-block';
                } else if (badge) {
                    badge.style.display = 'none';
                }
            })
            .catch(() => {});
    }, 60000);
</script>