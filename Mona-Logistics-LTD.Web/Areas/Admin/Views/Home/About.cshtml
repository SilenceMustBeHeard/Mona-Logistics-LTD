@{
    ViewData["Title"] = Localizer["AboutTitle"];
}

<div class="about-page">
    <!-- Hero Section -->
    <section class="about-hero">
        <div class="container">
            <div class="about-hero-content">
                <div class="hero-badge">Mona Logistics LTD</div>
                <h1 class="about-hero-title">@Localizer["AboutHeroTitle"]</h1>
                <div class="about-hero-line"></div>
                <p class="about-hero-subtitle">
                    @Localizer["AboutHeroSubtitle"]
                </p>
            </div>
        </div>
    </section>

    <!-- Mission Section -->
    <section class="mission-statement">
        <div class="container">
            <div class="mission-quote">
                <p class="quote-text">
                    @Localizer["AboutMissionQuote"]
                </p>
            </div>
        </div>
    </section>

    <!-- Commitment Section -->
    <section class="commitment-section">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-lg-6 order-lg-2 mb-4 mb-lg-0">
                    <div class="commitment-image">
                        <div class="image-placeholder">
                            <div class="placeholder-content">
                                <span>@Localizer["AboutPillar1"]</span>
                                <span>@Localizer["AboutPillar2"]</span>
                                <span>@Localizer["AboutPillar3"]</span>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-lg-6 order-lg-1">
                    <div class="commitment-content">
                        <span class="section-tag">@Localizer["AboutCommitmentTag"]</span>
                        <h2 class="section-title">@Localizer["AboutCommitmentTitle"] <span class="highlight">@Localizer["AboutCommitmentHighlight"]</span></h2>
                        <div class="section-line"></div>
                        <p class="commitment-text">
                            @Localizer["AboutCommitmentText"]
                        </p>
                        <div class="pillars">
                            <div class="pillar">
                                <span class="pillar-number">01</span>
                                <span class="pillar-name">@Localizer["AboutPillar1"]</span>
                            </div>
                            <div class="pillar">
                                <span class="pillar-number">02</span>
                                <span class="pillar-name">@Localizer["AboutPillar2"]</span>
                            </div>
                            <div class="pillar">
                                <span class="pillar-number">03</span>
                                <span class="pillar-name">@Localizer["AboutPillar3"]</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Why Choose Us -->
    <section class="why-section">
        <div class="container">
            <div class="text-center mb-5">
                <span class="section-tag">@Localizer["AboutWhyTag"]</span>
                <h2 class="section-title">@Localizer["AboutWhyTitle"] <span class="highlight">@Localizer["AboutWhyHighlight"]</span><br>@Localizer["AboutWhySubtitle"]</h2>
                <div class="section-line mx-auto"></div>
            </div>
            <div class="row g-4">
                <div class="col-md-4">
                    <div class="why-card">
                        <div class="why-number">01</div>
                        <h3>@Localizer["AboutWhy1Title"]</h3>
                        <p>@Localizer["AboutWhy1Desc"]</p>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="why-card">
                        <div class="why-number">02</div>
                        <h3>@Localizer["AboutWhy2Title"]</h3>
                        <p>@Localizer["AboutWhy2Desc"]</p>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="why-card">
                        <div class="why-number">03</div>
                        <h3>@Localizer["AboutWhy3Title"]</h3>
                        <p>@Localizer["AboutWhy3Desc"]</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Stats & Closing -->
    <section class="closing-section">
        <div class="container">
            <div class="closing-card">
                <div class="row align-items-center">
                    <div class="col-lg-8">
                        <p class="closing-text">
                            @Localizer["AboutClosingText"]
                        </p>
                    </div>
                    <div class="col-lg-4 text-lg-end mt-4 mt-lg-0">
                        <a href="/Contact" class="btn-closing">@Localizer["AboutContactBtn"]</a>
                    </div>
                </div>
            </div>
        </div>
    </section>
</div>