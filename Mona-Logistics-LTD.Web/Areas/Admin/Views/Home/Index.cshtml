@using Mona_Logistics_LTD.Services.Localizer.Interfaces
@inject IJsonLocalizer Localizer

@{
    ViewData["Title"] = Localizer["AdminHomeTitle"];
}

<div class="admin-command-center">

    <!-- HEADER / STATUS BAR -->

    <div class="command-header">
        <div class="command-header-left">
            <div class="command-status">
                <span class="status-dot pulse"></span>
                <span class="status-text">@Localizer["SystemOnline"]</span>
            </div>
            <span class="command-divider">|</span>
            <span class="command-time" id="commandTime">00:00:00</span>
            <span class="command-divider">|</span>
            <span class="command-version">v2.4.1</span>
        </div>
        <div class="command-header-right">
            <span class="command-user">
                <i class="bi bi-shield-lock-fill"></i>
                @User.Identity?.Name
            </span>
        </div>
    </div>

    
    <!-- QUICK STATS ROW -->

    <div class="command-stats">
        <div class="stat-item">
            <div class="stat-icon"><i class="bi bi-box-seam"></i></div>
            <div class="stat-data">
                <span class="stat-number" id="statTotal">0</span>
                <span class="stat-label">@Localizer["TotalRequests"]</span>
            </div>
            <div class="stat-change up">+12%</div>
        </div>
        <div class="stat-item">
            <div class="stat-icon"><i class="bi bi-clock-history"></i></div>
            <div class="stat-data">
                <span class="stat-number" id="statPending">0</span>
                <span class="stat-label">@Localizer["PendingRequests"]</span>
            </div>
            <div class="stat-change down">-3%</div>
        </div>
        <div class="stat-item">
            <div class="stat-icon"><i class="bi bi-people"></i></div>
            <div class="stat-data">
                <span class="stat-number" id="statUsers">0</span>
                <span class="stat-label">@Localizer["TotalUsers"]</span>
            </div>
            <div class="stat-change up">+8%</div>
        </div>
        <div class="stat-item">
            <div class="stat-icon"><i class="bi bi-truck"></i></div>
            <div class="stat-data">
                <span class="stat-number" id="statTrucks">0</span>
                <span class="stat-label">@Localizer["ActiveTrucks"]</span>
            </div>
            <div class="stat-change">-</div>
        </div>
        <div class="stat-item">
            <div class="stat-icon"><i class="bi bi-envelope-paper"></i></div>
            <div class="stat-data">
                <span class="stat-number" id="statMessages">0</span>
                <span class="stat-label">@Localizer["UnreadMessages"]</span>
            </div>
            <div class="stat-change up">+5</div>
        </div>
    </div>


    <!-- MAIN GRID -->

    <div class="command-grid">

        <!-- LEFT COLUMN -->
        <div class="command-left">

            <!-- Recent Requests -->
            <div class="command-panel">
                <div class="panel-header">
                    <h4><i class="bi bi-box-seam"></i> @Localizer["RecentRequests"]</h4>
                    <a asp-area="Admin" asp-controller="LoadRequest" asp-action="Index">@Localizer["ViewAll"] →</a>
                </div>
                <div class="panel-body">
                    <div class="request-item">
                        <span class="request-status pending"></span>
                        <span class="request-cargo">Electronics - 3 pallets</span>
                        <span class="request-client">TechSolutions Ltd.</span>
                        <span class="request-time">2 min ago</span>
                    </div>
                    <div class="request-item">
                        <span class="request-status pending"></span>
                        <span class="request-cargo">Furniture - 12 boxes</span>
                        <span class="request-client">Interior Design BG</span>
                        <span class="request-time">15 min ago</span>
                    </div>
                    <div class="request-item">
                        <span class="request-status offered"></span>
                        <span class="request-cargo">Medical supplies</span>
                        <span class="request-client">Pharma Ltd.</span>
                        <span class="request-time">42 min ago</span>
                    </div>
                    <div class="request-item">
                        <span class="request-status completed"></span>
                        <span class="request-cargo">Food products</span>
                        <span class="request-client">Fresh Market</span>
                        <span class="request-time">2 hours ago</span>
                    </div>
                </div>
            </div>

            <!-- Quick Actions -->
            <div class="command-panel">
                <div class="panel-header">
                    <h4><i class="bi bi-lightning-charge-fill"></i> @Localizer["QuickActions"]</h4>
                </div>
                <div class="panel-body quick-actions">
                    <a asp-area="Admin" asp-controller="LoadRequest" asp-action="Index" class="quick-btn primary">
                        <i class="bi bi-box-seam"></i> @Localizer["ViewRequests"]
                    </a>
                    <a asp-area="Admin" asp-controller="SystemMessage" asp-action="Create" class="quick-btn accent">
                        <i class="bi bi-megaphone"></i> @Localizer["SendAnnouncement"]
                    </a>
                    <a asp-area="Admin" asp-controller="UserManagement" asp-action="Index" class="quick-btn secondary">
                        <i class="bi bi-people"></i> @Localizer["ManageUsers"]
                    </a>
                    <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index" class="quick-btn outline">
                        <i class="bi bi-speedometer2"></i> @Localizer["FullDashboard"]
                    </a>
                </div>
            </div>
        </div>

        <!-- RIGHT COLUMN -->
        <div class="command-right">

            <!-- Activity Timeline -->
            <div class="command-panel">
                <div class="panel-header">
                    <h4><i class="bi bi-clock-history"></i> @Localizer["RecentActivity"]</h4>
                </div>
                <div class="panel-body activity-timeline">
                    <div class="activity-item">
                        <span class="activity-dot green"></span>
                        <div class="activity-content">
                            <span class="activity-text"><strong>@Localizer["NewLoadRequest"]</strong> - TechSolutions</span>
                            <span class="activity-time">2 min</span>
                        </div>
                    </div>
                    <div class="activity-item">
                        <span class="activity-dot blue"></span>
                        <div class="activity-content">
                            <span class="activity-text"><strong>@Localizer["OfferSent"]</strong> - Interior Design</span>
                            <span class="activity-time">18 min</span>
                        </div>
                    </div>
                    <div class="activity-item">
                        <span class="activity-dot green"></span>
                        <div class="activity-content">
                            <span class="activity-text"><strong>@Localizer["UserRegistered"]</strong> - new@client.com</span>
                            <span class="activity-time">1 hour</span>
                        </div>
                    </div>
                    <div class="activity-item">
                        <span class="activity-dot purple"></span>
                        <div class="activity-content">
                            <span class="activity-text"><strong>@Localizer["ShipmentDelivered"]</strong> - #TRK-2025-001</span>
                            <span class="activity-time">3 hours</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- System Status -->
            <div class="command-panel">
                <div class="panel-header">
                    <h4><i class="bi bi-server"></i> @Localizer["SystemStatus"]</h4>
                </div>
                <div class="panel-body system-status">
                    <div class="status-row">
                        <span class="status-label">@Localizer["Database"]</span>
                        <span class="status-value operational"><i class="bi bi-check-circle-fill"></i> @Localizer["Operational"]</span>
                    </div>
                    <div class="status-row">
                        <span class="status-label">@Localizer["EmailService"]</span>
                        <span class="status-value operational"><i class="bi bi-check-circle-fill"></i> @Localizer["Operational"]</span>
                    </div>
                    <div class="status-row">
                        <span class="status-label">@Localizer["ApiService"]</span>
                        <span class="status-value operational"><i class="bi bi-check-circle-fill"></i> @Localizer["Operational"]</span>
                    </div>
                    <div class="status-row">
                        <span class="status-label">@Localizer["CacheService"]</span>
                        <span class="status-value warning"><i class="bi bi-exclamation-triangle-fill"></i> @Localizer["Degraded"]</span>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        // Real time clock
        function updateClock() {
            const now = new Date();
            document.getElementById('commandTime').textContent = now.toTimeString().split(' ')[0];
        }
        updateClock();
        setInterval(updateClock, 1000);

        // Animate numbers
        function animateNumber(el, target, duration = 1200) {
            const start = 0;
            const startTime = performance.now();
            function update(t) {
                const progress = Math.min((t - startTime) / duration, 1);
                el.textContent = Math.floor(progress * target);
                if (progress < 1) requestAnimationFrame(update);
                else el.textContent = target;
            }
            requestAnimationFrame(update);
        }

        // Sample data - replace with real API
        const data = {
            total: 156,
            pending: 12,
            users: 89,
            trucks: 34,
            messages: 7
        };

        animateNumber(document.getElementById('statTotal'), data.total);
        animateNumber(document.getElementById('statPending'), data.pending);
        animateNumber(document.getElementById('statUsers'), data.users);
        animateNumber(document.getElementById('statTrucks'), data.trucks);
        animateNumber(document.getElementById('statMessages'), data.messages);

        // Hover effects
        document.querySelectorAll('.stat-item, .command-panel').forEach(el => {
            el.addEventListener('mouseenter', function() {
                this.style.borderColor = 'rgba(212,160,23,0.3)';
            });
            el.addEventListener('mouseleave', function() {
                this.style.borderColor = '';
            });
        });
    });
</script>